<Window x:Class="HrpayrollDesktop.DeviceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Up This Reader" Height="560" Width="440"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="Set Up This Reader" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Register this fingerprint reader with the server so attendance, enrolment and damages work. You can close this window and do it later."
                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Reader serial" Foreground="#AAAAAA" FontSize="12"/>
            <TextBox x:Name="DeviceSerialBox" FontSize="14" Padding="6" Margin="0,2,0,16" IsReadOnly="True"/>

            <TextBlock Text="1. Back Office sign-in" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Username" Foreground="#AAAAAA" FontSize="12"/>
            <TextBox x:Name="UsernameBox" FontSize="14" Padding="6" Margin="0,2,0,8"/>
            <TextBlock Text="Password" Foreground="#AAAAAA" FontSize="12"/>
            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="6" Margin="0,2,0,8"/>
            <Button x:Name="SignInButton" Content="Sign in" Padding="8" Click="SignInButton_Click"/>

            <StackPanel x:Name="BranchPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="2. Branch this reader serves" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="BranchCombo" DisplayMemberPath="Name" FontSize="14" Padding="6" Margin="0,0,0,8"/>
                <Button x:Name="RegisterButton" Content="Register this reader" Padding="8" Click="RegisterButton_Click"/>
            </StackPanel>

            <Expander Header="Already have a token from an administrator?" Foreground="#AAAAAA" Margin="0,20,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBox x:Name="TokenBox" FontSize="14" Padding="6" Margin="0,0,0,8"/>
                    <Button x:Name="SaveTokenButton" Content="Save token" Padding="8" Click="SaveTokenButton_Click"/>
                </StackPanel>
            </Expander>

            <TextBlock x:Name="StatusText" Foreground="#F87171" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>