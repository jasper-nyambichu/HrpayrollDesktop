<Window x:Class="HrpayrollDesktop.DeviceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Up This Device" Height="320" Width="400"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="30">
        <TextBlock Text="Set Up This Device" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Device Serial (give this to your admin)" Foreground="#AAAAAA" FontSize="12"/>
        <TextBox x:Name="DeviceSerialBox" FontSize="14" Padding="6" Margin="0,2,0,14" IsReadOnly="True"/>

        <TextBlock Text="Device Token (from admin)" Foreground="#AAAAAA" FontSize="12"/>
        <TextBox x:Name="TokenBox" FontSize="14" Padding="6" Margin="0,2,0,16"/>

        <Button x:Name="SaveButton" Content="Save and Continue" Padding="8" Click="SaveButton_Click"/>
        <TextBlock x:Name="StatusText" Foreground="#F87171" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>