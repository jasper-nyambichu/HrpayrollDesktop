<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <LangVersion>latest</LangVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>HrpayrollDesktop</AssemblyName>
    <ApplicationIcon>Assets\dhwarsh.ico</ApplicationIcon>

    <!-- Shown in Windows' installed apps list. Raise Version for every installer you hand out. -->
    <Version>1.4.3</Version>
    <Company>DhwarshHub</Company>
    <Product>Dhwarsh Employee Management</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- SecuGen SDK files live inside the project (Libs\SecuGen\x64), so no machine-specific path is needed. -->
  <ItemGroup>
    <Reference Include="SecuGen.FDxSDKPro.Windows">
      <HintPath>Libs\SecuGen\x64\SecuGen.FDxSDKPro.Windows.dll</HintPath>
    </Reference>
  </ItemGroup>

    <ItemGroup>
    <None Include="Libs\SecuGen\x64\*.dll" Exclude="Libs\SecuGen\x64\SecuGen.FDxSDKPro.Windows.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Without these the images and fonts are not in the app, and every picture on screen comes up blank. -->
  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\dhwarsh.ico" />
    <Resource Include="Assets\3D\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.otf" />
  </ItemGroup>

</Project>