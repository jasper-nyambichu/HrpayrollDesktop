<Window x:Class="HrpayrollDesktop.KioskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dhwarsh HR — Clock In" WindowState="Maximized" WindowStyle="None"
        Background="#0B192C">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#0B172A">
            <Grid Margin="32,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#1AFFFFFF" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="5">
                        <Image Source="/Assets/dhwarsh-logo.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Dhwarsh HR" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="StationLabelText" Text="Biometric Attendance Terminal" Foreground="#8FA6C2" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LiveClockText" Text="08:14:32 AM" Foreground="White" FontSize="24" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveDateText" Text="Monday, September 28, 2026" Foreground="#8FA6C2" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Central stage -->
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Sensor circle with layered rings -->
                <Grid Width="330" Height="330" Margin="0,0,0,32">
                    <Ellipse x:Name="OuterRing" Width="330" Height="330" Stroke="#332C6FBB" StrokeThickness="1"/>
                    <Ellipse x:Name="MidRing" Width="280" Height="280" Stroke="#4D2C6FBB" StrokeThickness="1" StrokeDashArray="4 3"/>
                    <Border x:Name="SensorCard" Width="220" Height="220" CornerRadius="110" BorderThickness="3" BorderBrush="#802C6FBB">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#102B47" Offset="0"/>
                                <GradientStop Color="#0A1A2E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="SensorIcon" Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="100"
                                   Foreground="#7DC4F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="HeadlineText" Text="Place your finger on the reader" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubheadlineText" Text="to clock in or out" Foreground="#8FA6C2" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <Border x:Name="ResultBadge" Background="#264ADE80" BorderBrush="#4D4ADE80" BorderThickness="1" CornerRadius="10"
                        Padding="16,9" Margin="0,18,0,0" Visibility="Collapsed" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ResultBadgeText" Text="" Foreground="#B8F0CC" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#0B172A">
            <Grid Margin="24,0">
                <Button x:Name="ManagerLoginButton" Content="Manager Login" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#5C7A9E" FontSize="11" BorderThickness="0" Cursor="Hand"
                        Click="ManagerLoginButton_Click"/>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5C7A9E" FontSize="10">
                    <Run Text="Firm light pressure  •  Clean dry surface"/>
                </TextBlock>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1AFFFFFF" CornerRadius="999" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="FooterStatusDot" Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FooterStatusText" Text="Reader Connected" Foreground="#CBD5E1" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>