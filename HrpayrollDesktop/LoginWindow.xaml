<Window x:Class="HrpayrollDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dhwarsh HR Desktop" Height="660" Width="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="White">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Windows-style title bar, matching the dark header strip in the design -->
        <Border Grid.Row="0" Background="#0B172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="16" Height="16" Background="{StaticResource BlueBrush}" CornerRadius="3">
                        <TextBlock Text="D" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Dhwarsh HR Desktop — Branch Console" Foreground="#CBD5E1" FontSize="11" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11"
                            Width="44" Height="36" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10"
                            Width="44" Height="36" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="MaximizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                    <Button x:Name="CloseButton" Content="&#xE5CD;" FontFamily="{StaticResource IconFont}" FontSize="12"
                            Width="44" Height="36" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: split-screen -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Hero brand panel -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F2A4A" Offset="0"/>
                            <GradientStop Color="#1B365D" Offset="0.5"/>
                            <GradientStop Color="#2563A8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Decorative ambient blur orbs, matching the CSS blur-3xl circles -->
                <Ellipse Width="380" Height="380" Fill="#4D2563A8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-120,0,0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="70"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="440" Height="440" Fill="#267CB342" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-140">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Grid Margin="44">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top brand lockup — real logo, not a placeholder letter -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="48" Height="48" Background="#1AFFFFFF" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6">
                            <Image Source="/Assets/dhwarsh-logo.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DHWARSH HR" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Branch Operations Hub" Foreground="#B9D3F0" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Middle headline -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="440" HorizontalAlignment="Left">
                        <Border Background="#1AFFFFFF" CornerRadius="999" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Connected to Nairobi Regional Sync Server" Foreground="#7CD9A5" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Your whole workforce," Foreground="White" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" LineHeight="40"/>
                        <TextBlock FontSize="34" FontWeight="Bold" TextWrapping="Wrap" LineHeight="40" Margin="0,0,0,16">
                            <TextBlock.Text>one clear view.</TextBlock.Text>
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#BFE3FF" Offset="0"/>
                                    <GradientStop Color="#DDF4E8" Offset="0.55"/>
                                    <GradientStop Color="#7CD9A5" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Dhwarsh HR: Integrated Kenya payroll &amp; biometric attendance management tailored for high-volume branch terminals."
                                   Foreground="#C6DCF5" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>

                    <!-- Bottom floating stat cards -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">

                        <!-- Present Today card -->
                        <Border Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14" Width="176" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="PRESENT TODAY" Foreground="#BFE3FF" FontSize="9" FontWeight="Bold"/>
                                    <Border Width="26" Height="26" Background="#334ADE80" CornerRadius="8" HorizontalAlignment="Right" BorderBrush="#664ADE80" BorderThickness="1">
                                        <TextBlock Text="&#xE86C;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#7CD9A5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Bottom">
                                    <TextBlock Text="142" Foreground="White" FontSize="24" FontWeight="Black"/>
                                    <TextBlock Text=" 94.6%" Foreground="#7CD9A5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                                </StackPanel>
                                <TextBlock Text="Nairobi CBD Main Hub" Foreground="#9FC1E8" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- On-time ratio donut card (visual approximation) -->
                        <Border Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="48" Height="48" Margin="0,0,12,0">
                                    <Ellipse Stroke="#1AFFFFFF" StrokeThickness="4" Width="48" Height="48"/>
                                    <Path Stroke="#4ADE80" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 24,2 A 22,22 0 1 1 4.5,32">
                                    </Path>
                                    <Path Stroke="#FBBF24" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4.5,32 A 22,22 0 0 1 8,10">
                                    </Path>
                                    <TextBlock Text="7:00a" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ON-TIME RATIO" Foreground="#BFE3FF" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="128 On Time" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    <TextBlock Text="14 Late Arrival" Foreground="#FBBF24" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Terminal status pill -->
                        <Border Background="#4D000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="999" Padding="12,7" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Terminal Kiosk #01" Foreground="#D6E4F5" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RIGHT: Login card -->
            <Grid Grid.Column="1" Background="White">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">

                    <Image Source="/Assets/dhwarsh-logo.png" Height="96" Margin="0,0,0,24" Stretch="Uniform"/>

                    <TextBlock Text="Welcome back" Foreground="{StaticResource HeadingBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please enter your branch manager credentials to sign in." Foreground="{StaticResource MutedBrush}"
                               FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,26"/>

                    <TextBlock Text="MANAGER USERNAME OR WORK ID" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="UsernameBox" Padding="36,9,12,9"/>
                        <TextBlock Text="&#xE779;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Text="SECURITY PIN / PASSWORD" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="PasswordBox" Padding="36,9,36,9"/>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="&#xE890;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Remember terminal session" IsChecked="True" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Forgot password?" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="LoadingText" Text="Signing in..." Foreground="{StaticResource BlueBrush}" FontSize="12"
                               Margin="0,10,0,4" Visibility="Collapsed" HorizontalAlignment="Center"/>

                    <Button x:Name="LoginButton" Click="LoginButton_Click" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sign In to Console" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock Text="Tap Fingerprint Reader to Authorize" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,16,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SecuGen Reader: Ready" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Branch: Head Office" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>