<Window x:Class="HrpayrollDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dhwarsh HR Desktop" Height="760" Width="1300"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <Grid>
        <!-- Layer 1: the whole app layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#0B172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="16" Height="16" Background="{StaticResource BlueBrush}" CornerRadius="3">
                            <TextBlock Text="D" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleBarText" Text="Dhwarsh HR Desktop — Branch Manager Console" Foreground="#CBD5E1" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="44" Height="36"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" Width="44" Height="36"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="MaximizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="12" Width="44" Height="36"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: sidebar + main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Height="64" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                            <Grid Margin="16,0">
                                <StackPanel x:Name="SidebarBrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
                                        <Image Source="/Assets/dhwarsh-logo.png" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel x:Name="SidebarTextGroup" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DHWARSH" Foreground="White" FontSize="13" FontWeight="Black"/>
                                        <TextBlock x:Name="SidebarRoleText" Text="Branch Manager" Foreground="#9FC1E8" FontSize="10" FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="SidebarToggleButton" Content="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                        Width="32" Height="32" HorizontalAlignment="Right" Background="Transparent" Foreground="#CBD5E1"
                                        BorderThickness="0" Click="SidebarToggleButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="12,12">
                            <ToggleButton x:Name="NavDashboard" IsChecked="True" Style="{StaticResource SidebarNavStyle}" Click="NavDashboard_Click" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                                    <TextBlock x:Name="NavDashboardLabel" Text="Dashboard" FontSize="13" FontWeight="SemiBold" Margin="14,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="NavEnroll" Style="{StaticResource SidebarNavStyle}" Click="NavEnroll_Click" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90D;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                                    <TextBlock x:Name="NavEnrollLabel" Text="Enroll Employee" FontSize="13" FontWeight="SemiBold" Margin="14,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <Border Style="{StaticResource SidebarNavStaticStyle}" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="NavAttendanceLabel" Text="Attendance" FontSize="13" FontWeight="Medium" Foreground="#CBD5E1" Margin="14,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SidebarNavStaticStyle}" Margin="0,0,0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE977;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="NavDeviceLabel" Text="Device" FontSize="13" FontWeight="Medium" Foreground="#CBD5E1" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DeviceNavDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SidebarNavStaticStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="NavHelpLabel" Text="Help" FontSize="13" FontWeight="Medium" Foreground="#CBD5E1" Margin="14,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#1A000000" Padding="12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource NavyBrush}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="2">
                                        <TextBlock x:Name="UserInitialText" Text="B" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel x:Name="SidebarUserTextGroup" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SidebarUserNameText" Text="Branch Manager" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="SidebarUserRoleText" Text="Branch Mgr" Foreground="#94A3B8" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="LogoutButton" Content="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                        HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" Foreground="#94A3B8"
                                        BorderThickness="0" Click="LogoutButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="28,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GreetingText" Text="Hello, Branch Manager" Foreground="{StaticResource HeadingBrush}" FontSize="19" FontWeight="Black"/>
                                    <Border Background="#E0EBFA" CornerRadius="999" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Branch Manager" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SessionText" Text="Welcome back." Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Medium" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DeviceStatusText" Text="Fingerprint reader: connecting..." Foreground="#047857" FontSize="11" FontWeight="Bold" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Height="24" Background="{StaticResource BorderLightBrush}" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TopbarUserNameText" Text="Branch Manager" Foreground="{StaticResource HeadingBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Console Active" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                </StackPanel>
                                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource NavyBrush}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="2" Margin="10,0,0,0">
                                    <TextBlock x:Name="TopbarUserInitialText" Text="B" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28">
                        <StackPanel>

                            <!-- ===== DASHBOARD VIEW ===== -->
                            <StackPanel x:Name="DashboardView">

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="12" Padding="18">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2C6FBB" Offset="0"/>
                                                <GradientStop Color="#2563A8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="EMPLOYEES ENROLLED" Foreground="#DCEBFB" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="EmployeesEnrolledText" Text="—" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,6,0,0"/>
                                            <TextBlock Text="All active staff registered on local scanner" Foreground="#C6DCF5" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="12" Padding="18">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1E5DA6" Offset="0"/>
                                                <GradientStop Color="#154682" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="PRESENT TODAY" Foreground="#DCEBFB" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="PresentTodayCountText" Text="—" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,6,0,0"/>
                                            <TextBlock Text="Live count of today's clock-ins" Foreground="#C6DCF5" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" CornerRadius="12" Padding="18">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1B365D" Offset="0"/>
                                                <GradientStop Color="#0F2A4A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="DEVICE STATUS" Foreground="#DCEBFB" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="DeviceStatusCardText" Text="Connecting" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="DeviceSerialText" Text="SecuGen Reader" Foreground="#C6DCF5" FontSize="10" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border x:Name="SystemAlertBorder" Background="{StaticResource NavyBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="#334F5821" CornerRadius="8">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="SystemAlertText" Text="" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Today's Attendance Log" Style="{StaticResource SectionTitleStyle}"/>
                                        <ItemsControl x:Name="TodayAttendanceList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding EmployeeName}" Foreground="{StaticResource HeadingBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TodayAttendanceEmptyText" Text="No employees have clocked in yet today." Foreground="{StaticResource MutedBrush}" FontSize="12" Visibility="Collapsed" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== ENROLL VIEW ===== -->
                            <StackPanel x:Name="EnrollView" Visibility="Collapsed">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource BlueBrush}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Enroll Employee" Foreground="{StaticResource HeadingBrush}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Register a staff fingerprint template into this branch kiosk." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="STAFF MEMBER" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="EmployeeComboBox" DisplayMemberPath="DisplayLabel" Margin="0,0,0,16"/>

                                        <Button x:Name="EnrollButton" Click="EnrollButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="Enroll Fingerprint" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Layer 2: Toast, floats over everything -->
        <Border x:Name="ToastBorder" Visibility="Collapsed" CornerRadius="8" Padding="14,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="440">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>