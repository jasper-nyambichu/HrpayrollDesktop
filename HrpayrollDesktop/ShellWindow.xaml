<Window x:Class="HrpayrollDesktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HrpayrollDesktop"
        Title="Dhwarsh Employee Management"
        Icon="/Assets/dhwarsh.ico"
        Width="1366" Height="768" MinWidth="720" MinHeight="420"
        WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OuterBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <!-- Keeps the window resizable without the white strip Windows otherwise draws along the top -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- The screens are laid out for at least 1200 x 680. On a smaller screen or window the whole app is
             scaled down evenly (FitToWindow) instead of panels overlapping or running off the edge. -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="FitScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title strip: drag here to move the window -->
            <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="/Assets/dhwarsh-mark.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Dhwarsh Employee Management" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- The white panel from the design, floating on the light background -->
            <Border Grid.Row="1" Margin="18,0,18,18" CornerRadius="24" Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowMid}">
                <Grid>
                    <local:KioskView x:Name="Kiosk"/>
                    <local:ConsoleView x:Name="ManagerConsole" Visibility="Collapsed"/>
                    <local:ManualCheckInView x:Name="ManualCheckIn" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <local:LoginView x:Name="Login" Visibility="Collapsed"/>
        <local:PopupHost x:Name="Popups"/>

        <!-- Window controls -->
        <StackPanel x:Name="CaptionBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="MinButton" Style="{StaticResource CaptionBtn}" Content="&#xE921;" ToolTip="Minimize" Click="MinButton_Click"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionBtn}" Content="&#xE923;" ToolTip="Restore down" Click="MaxButton_Click"/>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseBtn}" Content="&#xE8BB;" ToolTip="Close" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
