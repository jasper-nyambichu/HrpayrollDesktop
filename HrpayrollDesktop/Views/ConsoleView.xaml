<UserControl x:Class="HrpayrollDesktop.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HrpayrollDesktop"
             SizeChanged="Root_SizeChanged">

    <UserControl.Resources>
        <!-- Latest activity row -->
        <DataTemplate x:Key="LiveCardTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="8" Padding="8,2" Background="{Binding StatusBg}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="9" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Time-log table -->
        <DataTemplate x:Key="LogHeaderTemplate">
            <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="10" Padding="12,9" Margin="0,12,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource TableHead}"/>
                    <TextBlock Grid.Column="1" Text="EMPLOYEE" Style="{StaticResource TableHead}"/>
                    <TextBlock Grid.Column="2" Text="CLOCK IN" Style="{StaticResource TableHead}"/>
                    <TextBlock Grid.Column="3" Text="CLOCK OUT" Style="{StaticResource TableHead}"/>
                    <TextBlock Grid.Column="4" Text="HOURS" Style="{StaticResource TableHead}"/>
                    <TextBlock Grid.Column="5" Text="BREAKS" Style="{StaticResource TableHead}"/>
                    <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource TableHead}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LogRowTemplate">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,9" Background="Transparent" ToolTip="{Binding Punches}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{Binding AvatarBg}">
                            <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EmployeeName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding ClockIn}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ClockOut}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Hours}" FontSize="11" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding Breaks}" FontSize="10" LineHeight="15" Foreground="{Binding BreaksFg}" FontWeight="Medium"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Grid.Column="6" CornerRadius="10" Padding="9,3" Background="{Binding StatusBg}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Enrollment picker row -->
        <DataTemplate x:Key="PickerItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <ContextMenu x:Key="GearMenu">
            <MenuItem Header="Device &amp; sync" Click="GearDevice_Click"/>
            <MenuItem Header="Help" Click="GearHelp_Click"/>
            <Separator/>
            <MenuItem Header="Sign out" Click="GearSignOut_Click"/>
            <MenuItem Header="Exit application" Click="GearExit_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border CornerRadius="18" Background="{StaticResource SidebarGradient}" Padding="14,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Click="SidebarToggle_Click" Cursor="Hand" ToolTip="Show or hide the menu" HorizontalAlignment="Center" Margin="0,4,0,24">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Border x:Name="LogoTile" Width="84" Height="84" CornerRadius="20" Background="White" Padding="9" Effect="{StaticResource ShadowMid}">
                            <Image Source="/Assets/dhwarsh-mark.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Button>

                    <StackPanel Grid.Row="1">
                        <ToggleButton x:Name="NavDashboard" Tag="Dashboard" IsChecked="True" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE871;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavDashboardLabel" Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavAttendance" Tag="Attendance" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavAttendanceLabel" Text="Time log" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavEnroll" Tag="Enroll" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavEnrollLabel" Text="Enroll employee" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavDaysWorked" Tag="DaysWorked" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE614;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavDaysWorkedLabel" Text="Days worked" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavDamages" Tag="Damages" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B2;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavDamagesLabel" Text="Damages" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavDevice" Tag="Device" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE627;" Style="{StaticResource Icon}"/>
                                    <TextBlock x:Name="NavDeviceLabel" Text="Device &amp; sync" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Ellipse x:Name="DeviceNavDot" Width="8" Height="8" Fill="#F2A900" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-4,0"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <ToggleButton x:Name="NavHelp" Tag="Help" Style="{StaticResource NavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavHelpLabel" Text="Help" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSignOut" Style="{StaticResource NavBtn}" Click="NavSignOut_Click" ToolTip="Back to the attendance screen" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9BA;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="NavSignOutLabel" Text="Sign out" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN ================= -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: search on the left, the signed-in person on the right, as in the design -->
                <Grid x:Name="HeaderBar" Margin="8,4,8,12" Background="Transparent" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                    <Border HorizontalAlignment="Left" Width="300" Height="44" CornerRadius="22" Background="White" Padding="16,0" Effect="{StaticResource ShadowSoft}">
                        <Grid>
                            <TextBlock Text="&#xE8B6;" Style="{StaticResource Icon}" FontSize="19" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                            <TextBox x:Name="HeaderSearchBox" Style="{StaticResource InputBox}" Margin="28,0,0,0" TextChanged="HeaderSearchBox_TextChanged"/>
                            <TextBlock x:Name="HeaderSearchPlaceholder" Text="Search employee" Margin="28,0,0,0" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid Margin="0,0,8,0">
                            <Button x:Name="BellButton" Style="{StaticResource IconBtn}" Content="&#xE7F4;" ToolTip="Notifications" Click="BellButton_Click"/>
                            <Ellipse x:Name="BellBadge" Width="10" Height="10" Fill="{StaticResource AmberBrush}" Stroke="White" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <Button x:Name="GearButton" Style="{StaticResource IconBtn}" Content="&#xE8B8;" ToolTip="Settings" Margin="0,0,14,0" Click="GearButton_Click"/>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource BlueFixedBrush}">
                            <TextBlock x:Name="HeaderAvatarText" Text="B" Foreground="{StaticResource PrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderNameText" Text="Back Office" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="HeaderSubText" Text="Back Office" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>

                        <!-- ============ DASHBOARD ============ -->
                        <Grid x:Name="DashboardPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="SystemAlertBorder" Background="{StaticResource ErrorSoftBrush}" CornerRadius="12" Padding="16,11" Margin="8,0,8,10" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE002;" Style="{StaticResource Icon}" Foreground="{StaticResource ErrorBrush}"/>
                                    <TextBlock x:Name="SystemAlertText" Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="Medium" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="DashGrid" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="DashSideColumn" Width="290"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="DashMain">
                                    <!-- Banner -->
                                    <Border CornerRadius="18" Background="{StaticResource HeroGradient}" Height="172" Margin="8,0,8,0" ClipToBounds="True">
                                        <Grid>
                                            <Ellipse Width="14" Height="14" Fill="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,216,0"/>
                                            <Ellipse Width="18" Height="18" Fill="#9FCAFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,30,0"/>
                                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="220" Height="172" IsHitTestVisible="False">
                                                <Image Source="/Assets/3D/worker.png" Width="172" Height="172" Canvas.Left="44" Canvas.Top="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Image Source="/Assets/3D/clipboard.png" Width="56" Height="56" Canvas.Left="6" Canvas.Top="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Canvas>
                                            <StackPanel Margin="26,0,230,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="HeroDateText" FontSize="11" Foreground="#D2E4FF"/>
                                                <TextBlock x:Name="HeroGreetingText" Text="Welcome back!" FontSize="22" LineHeight="32" FontWeight="Bold" Foreground="White" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="12" LineHeight="18" Foreground="#E6F0F8" TextWrapping="Wrap">
                                                    <Run x:Name="HeroRateRun" Text="0%" FontWeight="SemiBold"/><Run Text=" attendance today. "/><Run x:Name="HeroLateRun" Text=""/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Figures -->
                                    <TextBlock Text="Today" Style="{StaticResource SectionTitle}" Margin="8,16,8,0"/>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image Source="/Assets/3D/people.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="HeroPresentText" Text="0" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock Text="At work" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource StatCard}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image Source="/Assets/3D/hourglass.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="HeroNotInRun" Text="0" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock Text="Not yet in" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image Source="/Assets/3D/door.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="HeroOutRun" Text="0" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock Text="Clocked out" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Time log (today) -->
                                    <Border x:Name="TableCard" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Time log" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="Who reported today, their breaks, and when they left" Style="{StaticResource Sub}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource GhostBtn}" Content="See all" Click="ViewAll_Click" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource GhostBtn}" Click="ExportToday_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xF090;" Style="{StaticResource Icon}" FontSize="15"/>
                                                            <TextBlock Text="Export" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <ContentControl Content="h" ContentTemplate="{StaticResource LogHeaderTemplate}"/>
                                            <ItemsControl x:Name="DashboardLogList" ItemTemplate="{StaticResource LogRowTemplate}"/>
                                            <TextBlock x:Name="DashboardEmptyText" Text="No employees to show yet. Signing in loads your branch's employee list."
                                                       Style="{StaticResource Sub}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="DashboardFooterText" Style="{StaticResource Sub}" Margin="2,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Analytics chart -->
                                    <Border x:Name="ChartCard" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Attendance analytics" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock x:Name="ChartSubText" Style="{StaticResource Sub}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource SurfaceLowBrush}" CornerRadius="10" Padding="3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource SegBtn}" GroupName="ChartRange" Content="Today" Tag="Today" IsChecked="True" Checked="ChartRange_Checked"/>
                                                        <RadioButton Style="{StaticResource SegBtn}" GroupName="ChartRange" Content="7 days" Tag="7" Checked="ChartRange_Checked"/>
                                                        <RadioButton Style="{StaticResource SegBtn}" GroupName="ChartRange" Content="30 days" Tag="30" Checked="ChartRange_Checked"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                    <Ellipse Width="8" Height="8" Fill="#005592" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ChartLegendAText" Style="{StaticResource Sub}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                    <Ellipse Width="8" Height="8" Fill="#5BA7E6" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ChartLegendBText" Style="{StaticResource Sub}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel x:Name="ChartLegendC" Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#E4EDF4" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ChartLegendCText" Style="{StaticResource Sub}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Canvas x:Name="ChartCanvas" Height="230" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right column -->
                                <StackPanel x:Name="DashSide" Grid.Column="1">
                                    <TextBlock Text="At work now" Style="{StaticResource SectionTitle}" Margin="8,0,8,10"/>
                                    <Grid Margin="8,0,8,10" MinHeight="44">
                                        <StackPanel x:Name="HeroAvatars" Orientation="Horizontal"/>
                                    </Grid>

                                    <TextBlock Text="Today's status" Style="{StaticResource SectionTitle}" Margin="8,4,8,0"/>
                                    <Border x:Name="PieCard" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <TextBlock x:Name="PieSubText" Style="{StaticResource Sub}" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Canvas x:Name="PieCanvas" Width="132" Height="132"/>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="#005592" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Still in" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="LegendInText" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="#5BA7E6" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Clocked out" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="LegendOutText" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="#F2A900" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Not yet in" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="LegendAbsentText" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Key rates" Style="{StaticResource SectionTitle}" Margin="8,8,8,0"/>
                                    <Border x:Name="RingsCard" Style="{StaticResource Card}" Padding="10,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="84" Height="84" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Grid.LayoutTransform>
                                                    <Ellipse Width="76" Height="76" Stroke="#E4EDF4" StrokeThickness="9"/>
                                                    <Path x:Name="RingA" Stroke="#005592" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                                    <TextBlock x:Name="RingAText" Text="0%" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Attendance" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <Grid Width="84" Height="84">
                                                    <Grid.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Grid.LayoutTransform>
                                                    <Ellipse Width="76" Height="76" Stroke="#E4EDF4" StrokeThickness="9"/>
                                                    <Path x:Name="RingB" Stroke="#F2A900" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                                    <TextBlock x:Name="RingBText" Text="0%" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Enrolled" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <Grid Width="84" Height="84">
                                                    <Grid.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Grid.LayoutTransform>
                                                    <Ellipse Width="76" Height="76" Stroke="#E4EDF4" StrokeThickness="9"/>
                                                    <Path x:Name="RingC" Stroke="#5BA7E6" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                                    <TextBlock x:Name="RingCText" Text="0%" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Checked out" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Latest activity" Style="{StaticResource SectionTitle}" Margin="8,8,8,0"/>
                                    <Border x:Name="LiveSection" Style="{StaticResource Card}" Padding="16,16,16,6">
                                        <StackPanel>
                                            <ItemsControl x:Name="LiveList" ItemTemplate="{StaticResource LiveCardTemplate}"/>
                                            <TextBlock x:Name="LiveEmptyText" Text="Employees who clock in will appear here." Style="{StaticResource Sub}" FontSize="12"
                                                       Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ============ TIME LOG (full page) ============ -->
                        <StackPanel x:Name="AttendancePage" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Time log" Style="{StaticResource PageTitle}"/>
                                            <TextBlock x:Name="PageSummaryText" Style="{StaticResource Sub}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource GhostBtn}" Click="PrevDay_Click" ToolTip="Previous day">
                                                <TextBlock Text="&#xE5CB;" Style="{StaticResource Icon}" FontSize="16"/>
                                            </Button>
                                            <TextBlock x:Name="PageDateText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                                                       Margin="12,0" MinWidth="120" TextAlignment="Center"/>
                                            <Button x:Name="PageNextButton" Style="{StaticResource GhostBtn}" Click="NextDay_Click" ToolTip="Next day">
                                                <TextBlock Text="&#xE5CC;" Style="{StaticResource Icon}" FontSize="16"/>
                                            </Button>
                                            <Button x:Name="PageTodayButton" Style="{StaticResource GhostBtn}" Content="Today" Click="TodayDay_Click" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource GhostBtn}" Click="ExportPage_Click" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xF090;" Style="{StaticResource Icon}" FontSize="15"/>
                                                    <TextBlock Text="Export" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegBtn}" GroupName="PageFilter" Content="All" Tag="All" IsChecked="True" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource SegBtn}" GroupName="PageFilter" Content="In" Tag="In" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource SegBtn}" GroupName="PageFilter" Content="On a break" Tag="Break" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource SegBtn}" GroupName="PageFilter" Content="Late from lunch" Tag="Late" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource SegBtn}" GroupName="PageFilter" Content="Out" Tag="Out" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource SegBtn}" GroupName="PageFilter" Content="Not in" Tag="Absent" Checked="PageFilter_Checked"/>
                                        </StackPanel>
                                    </Border>

                                    <ContentControl Content="h" ContentTemplate="{StaticResource LogHeaderTemplate}"/>
                                    <ItemsControl x:Name="PageLogList" ItemTemplate="{StaticResource LogRowTemplate}"/>
                                    <TextBlock x:Name="PageEmptyText" Text="Nothing to show for this filter." Style="{StaticResource Sub}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ ENROLL ============ -->
                        <Grid x:Name="EnrollPage" Visibility="Collapsed" MaxWidth="1040" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" MinWidth="300"/>
                                <ColumnDefinition Width="7*" MinWidth="360"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Select employee" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Search your branch's employees, then pick who to enroll" Style="{StaticResource Sub}" Margin="0,2,0,12" TextWrapping="Wrap"/>
                                    <Border Style="{StaticResource InputShell}" Height="40">
                                        <Grid>
                                            <TextBlock Text="&#xE8B6;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                                            <TextBox x:Name="EmployeeSearchBox" Style="{StaticResource InputBox}" Margin="26,0,0,0" TextChanged="EmployeeSearchBox_TextChanged"/>
                                            <TextBlock x:Name="EmployeeSearchPlaceholder" Text="Type a name or employee number" Margin="26,0,0,0" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                    <ListBox x:Name="EmployeeListBox" Margin="0,10,0,0" MinHeight="260" MaxHeight="420" BorderThickness="0" Background="Transparent"
                                             ItemTemplate="{StaticResource PickerItemTemplate}" ItemContainerStyle="{StaticResource ListItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="EmployeeListBox_SelectionChanged"/>
                                    <TextBlock x:Name="EmployeeCountText" Style="{StaticResource Sub}" Margin="2,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="26">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="FINGERPRINT CAPTURE" Style="{StaticResource TableHead}" VerticalAlignment="Center"/>
                                        <Border x:Name="EnrollStagePill" HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="{StaticResource BlueFixedBrush}">
                                            <TextBlock x:Name="EnrollStagePillText" Text="Ready" Foreground="{StaticResource BlueBrush}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="EnrollTargetText" Text="Select an employee to begin" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                               Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>

                                    <Grid Width="220" Height="190" HorizontalAlignment="Center" Margin="0,10,0,4">
                                        <Ellipse x:Name="EnrollPulseRing" Width="176" Height="176" Fill="{StaticResource BlueSoftBrush}" RenderTransformOrigin="0.5,0.5" Visibility="Hidden">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="EnrollPulseScale"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Border Width="124" Height="142" CornerRadius="20" Background="{StaticResource TintGradient}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="2" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock x:Name="EnrollFingerGlyph" Text="&#xE90D;" Style="{StaticResource Icon}" FontSize="70" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                                                <Border x:Name="EnrollLaser" Height="3" VerticalAlignment="Top" Visibility="Hidden">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#001C6EB4" Offset="0"/>
                                                            <GradientStop Color="#FF005592" Offset="0.5"/>
                                                            <GradientStop Color="#001C6EB4" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="EnrollLaserTranslate"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="EnrollHeadlineText" Text="Ready to enroll" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Name="EnrollSubtext" Text="Select an employee, then press Enroll fingerprint." Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               MaxWidth="380" Margin="0,4,0,0" HorizontalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step1Circle" Width="22" Height="22" CornerRadius="11">
                                                <TextBlock x:Name="Step1Text" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="Step1Label" Text="Select" FontSize="11" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Width="24" Height="2" Background="{StaticResource LineBrush}" Margin="10,0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step2Circle" Width="22" Height="22" CornerRadius="11">
                                                <TextBlock x:Name="Step2Text" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="Step2Label" Text="Scan" FontSize="11" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Width="24" Height="2" Background="{StaticResource LineBrush}" Margin="10,0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step3Circle" Width="22" Height="22" CornerRadius="11">
                                                <TextBlock x:Name="Step3Text" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="Step3Label" Text="Save" FontSize="11" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                                        <Grid>
                                            <TextBlock Text="SecuGen reader" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                            <Button x:Name="EnrollButton" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Center" Click="EnrollButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}" FontSize="16" Foreground="White"/>
                                                    <TextBlock Text="Enroll fingerprint" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="EnrollSensorText" Text="Checking…" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ DEVICE ============ -->
                        <StackPanel x:Name="DevicePage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Device &amp; sync" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Fingerprint reader health and data waiting to reach the server" Style="{StaticResource Sub}" Margin="0,3,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Fingerprint reader" Style="{StaticResource Sub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DevReaderText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8"/>
                                        <TextBlock Grid.Row="1" Text="Serial number" Style="{StaticResource Sub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevSerialText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8"/>
                                        <TextBlock Grid.Row="2" Text="Fingerprints enrolled" Style="{StaticResource Sub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DevEnrolledText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8"/>
                                        <TextBlock Grid.Row="3" Text="Employees on this branch" Style="{StaticResource Sub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DevEmployeesText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8"/>
                                        <TextBlock Grid.Row="4" Text="Scans waiting to sync" Style="{StaticResource Sub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DevPendingText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8"/>
                                    </Grid>
                                    <Button Content="Refresh" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RefreshDevice_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ DAYS WORKED, DAMAGES ============ -->
                        <local:DaysWorkedView x:Name="DaysWorkedPage" Visibility="Collapsed" MaxWidth="1040" HorizontalAlignment="Stretch"/>
                        <local:DamagesView x:Name="DamagesPage" Visibility="Collapsed" MaxWidth="1040" HorizontalAlignment="Stretch"/>

                        <!-- ============ HELP ============ -->
                        <StackPanel x:Name="HelpPage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Help" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" FontSize="12" LineHeight="20">
                                        <Run FontWeight="SemiBold" Text="Scanning at the reader"/><LineBreak/>
                                        <Run Text="No login is needed. The first scan of the day clocks an employee in. The next scan asks where they are going: a lunch break, a temporary check-out, or home for the day. Scanning again brings them back from a break."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Lunch breaks and temporary check-outs"/><LineBreak/>
                                        <Run Text="Lunch allows 30 minutes, and coming back later is recorded as late. A temporary check-out records the reason and the minutes the employee typed, and is never counted as late. With no internet, scans are saved on this PC and sent when it is back; the home screen's Sync status shows anything the server refused, and why."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Reading the Time log"/><LineBreak/>
                                        <Run Text="Every employee on the branch is listed. IN = at work, AT LUNCH or OUT TEMPORARILY = on a break, OUT = finished, NOT IN YET = has not reported, NOT ENROLLED = no fingerprint yet. The Breaks column shows lateness and reasons. Hover a row to see every scan."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Enrolling someone"/><LineBreak/>
                                        <Run Text="Open Enroll employee, search and pick the person, press Enroll fingerprint and have them place their finger on the reader."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Back to the attendance screen"/><LineBreak/>
                                        <Run Text="Use Sign out in the sidebar. The console also locks itself after 3 minutes without activity. Scanning keeps running the whole time."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Working offline"/><LineBreak/>
                                        <Run Text="Scans are saved on this computer and sync automatically when the connection returns. Signing in and enrolling need a connection."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Notifications (bell) -->
        <Popup x:Name="NotifyPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
               HorizontalOffset="-250" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="294" Background="White" CornerRadius="14" Padding="16" Margin="12" Effect="{StaticResource ShadowMid}">
                <StackPanel TextElement.FontFamily="{StaticResource AppFont}">
                    <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="NotifyList"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Toast -->
        <Border x:Name="ToastBorder" Visibility="Collapsed" CornerRadius="10" Padding="16,11" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" MaxWidth="460" Effect="{StaticResource ShadowMid}">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
