<UserControl x:Class="HrpayrollDesktop.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HrpayrollDesktop"
             TextElement.FontFamily="{StaticResource AppFont}"
             Background="#F2F6F7"
             SizeChanged="Root_SizeChanged">

    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- Palette (taken from the reference dashboard) -->
        <SolidColorBrush x:Key="CPine" Color="#0B3A35"/>
        <SolidColorBrush x:Key="CTeal" Color="#0F6B63"/>
        <SolidColorBrush x:Key="CInk" Color="#10302D"/>
        <SolidColorBrush x:Key="CMuted" Color="#7C8B8A"/>
        <SolidColorBrush x:Key="CLine" Color="#E6EDEF"/>
        <SolidColorBrush x:Key="CGold" Color="#F5B71E"/>

        <!-- Cards & text -->
        <Style x:Key="CCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="CTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
        </Style>
        <Style x:Key="CSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CMuted}"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="CGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CLine}" BorderThickness="1"
                                CornerRadius="10" Padding="13,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F8F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CTeal}" CornerRadius="12" Padding="26,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B5750"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CIconBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CLine}" BorderThickness="1" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control button -->
        <Style x:Key="CSegBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#5F7370"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="13,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3EEEC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F6B63"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation button -->
        <Style x:Key="CNavBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B9CFCB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,11" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F4A44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14584F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless search textbox (container supplies the look) -->
        <Style x:Key="CSearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List item for the enrollment picker -->
        <Style x:Key="CListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Padding="10,8" Margin="0,0,0,2" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F6F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDF0EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="VPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WPanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Latest-activity card (like the ad cards in the reference) -->
        <DataTemplate x:Key="LiveCardTemplate">
            <Border Background="White" BorderBrush="{StaticResource CLine}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Margin="0,0,12,12" MinWidth="248">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBg}">
                            <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="13"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource CInk}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Position}" Style="{StaticResource CSub}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="999" Padding="9,3" Background="{Binding StatusBg}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding BigValue}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CInk}"/>
                            <TextBlock Text="{Binding BigLabel}" Style="{StaticResource CSub}"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Path Data="{Binding Spark}" Stroke="{Binding SparkBrush}" StrokeThickness="2.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="110" Height="34" Stretch="None"/>
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource CSub}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Time-log table -->
        <DataTemplate x:Key="LogHeaderTemplate">
            <Border Background="#F3F7F7" CornerRadius="10" Padding="12,9" Margin="0,12,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="124"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                    <TextBlock Grid.Column="1" Text="EMPLOYEE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                    <TextBlock Grid.Column="2" Text="CLOCK IN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                    <TextBlock Grid.Column="3" Text="CLOCK OUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                    <TextBlock Grid.Column="4" Text="HOURS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                    <TextBlock Grid.Column="5" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LogRowTemplate">
            <Border BorderBrush="{StaticResource CLine}" BorderThickness="0,0,0,1" Padding="12,10" Background="Transparent"
                    ToolTip="{Binding Punches}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="124"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{StaticResource CMuted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{Binding AvatarBg}">
                            <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EmployeeName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource CInk}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CSub}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ClockIn}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource CInk}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ClockOut}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource CInk}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Hours}" FontSize="12" Foreground="{StaticResource CInk}" VerticalAlignment="Center"/>
                    <Border Grid.Column="5" CornerRadius="999" Padding="10,3" Background="{Binding StatusBg}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Enrollment picker row -->
        <DataTemplate x:Key="PickerItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource CSub}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <ContextMenu x:Key="GearMenu">
            <MenuItem Header="Device &amp; sync" Click="GearDevice_Click"/>
            <MenuItem Header="Help center" Click="GearHelp_Click"/>
            <Separator/>
            <MenuItem Header="Sign out (back to clock-in screen)" Click="GearSignOut_Click"/>
            <MenuItem Header="Exit application" Click="GearExit_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{StaticResource CPine}">
                <Grid Margin="12,18,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Click="SidebarToggle_Click" Cursor="Hand" ToolTip="Show / hide menu"
                            HorizontalAlignment="Left" Margin="0,0,0,22" Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="50" Height="44" Background="White" CornerRadius="12" Padding="6">
                                <Image Source="/Assets/dhwarsh-logo.png" Stretch="Uniform"/>
                            </Border>
                            <StackPanel x:Name="BrandTextGroup" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Dhwarsh HR" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Back Office console" Foreground="#9FC1BB" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="1">
                        <ToggleButton x:Name="NavDashboard" Tag="Dashboard" IsChecked="True" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavDashboardLabel" Text="Dashboard" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavAttendance" Tag="Attendance" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavAttendanceLabel" Text="Time Log" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavEnroll" Tag="Enroll" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavEnrollLabel" Text="Enroll Employee" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavDaysWorked" Tag="DaysWorked" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavDaysWorkedLabel" Text="Days worked" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavDamages" Tag="Damages" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavDamagesLabel" Text="Damages" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavDevice" Tag="Device" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE977;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                    <TextBlock x:Name="NavDeviceLabel" Text="Device &amp; Sync" Margin="14,0,0,0"/>
                                </StackPanel>
                                <Ellipse x:Name="DeviceNavDot" Width="8" Height="8" Fill="#F5821F" HorizontalAlignment="Right"
                                         VerticalAlignment="Center" Margin="0,0,-4,0"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <ToggleButton x:Name="NavHelp" Tag="Help" Style="{StaticResource CNavBtn}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavHelpLabel" Text="Help Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSignOut" Style="{StaticResource CNavBtn}" Click="NavSignOut_Click" ToolTip="Back to clock-in screen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="22"/>
                                <TextBlock x:Name="NavSignOutLabel" Text="Sign out" Margin="14,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header (right margin leaves room for the window controls) -->
                <Border x:Name="HeaderBar" Grid.Row="0" Background="White" BorderBrush="{StaticResource CLine}"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,150,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border Width="42" Height="42" CornerRadius="21" Background="#DDF0EC">
                                <TextBlock x:Name="HeaderAvatarText" Text="B" Foreground="{StaticResource CTeal}" FontSize="15"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderNameText" Text="Branch Manager" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource CInk}"/>
                                <TextBlock x:Name="HeaderSubText" Text="Branch Manager" Style="{StaticResource CSub}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Width="270" Height="40" CornerRadius="12" Background="#F1F5F6" Margin="0,0,12,0">
                                <Grid Margin="12,0">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource CMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="HeaderSearchBox" Style="{StaticResource CSearchBox}" Margin="26,0,0,0"
                                             TextChanged="HeaderSearchBox_TextChanged"/>
                                    <TextBlock x:Name="HeaderSearchPlaceholder" Text="Search employee" Margin="26,0,0,0"
                                               Foreground="{StaticResource CMuted}" FontSize="13" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,10,0">
                                <Button x:Name="BellButton" Style="{StaticResource CIconBtn}" Content="&#xEA8F;" ToolTip="Notifications"
                                        Click="BellButton_Click"/>
                                <Ellipse x:Name="BellBadge" Width="9" Height="9" Fill="#F28B6F" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" IsHitTestVisible="False"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <Button x:Name="GearButton" Style="{StaticResource CIconBtn}" Content="&#xE713;" ToolTip="Settings"
                                    Click="GearButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <Grid>

                        <!-- ============ DASHBOARD ============ -->
                        <StackPanel x:Name="DashboardPage">
                            <Border x:Name="SystemAlertBorder" Background="#0B3A35" CornerRadius="14" Padding="16,12"
                                    Margin="8,8,8,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#F5B71E"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SystemAlertText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="DashGrid">
                                <!-- Hero: attendance overview -->
                                <Border x:Name="HeroCard" CornerRadius="18" Padding="22" Margin="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10706A" Offset="0"/>
                                            <GradientStop Color="#0A524C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="Attendance overview" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                        <Grid Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HeroPresentText" Text="0" Foreground="{StaticResource CGold}"
                                                           FontSize="42" FontWeight="Bold"/>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Currently" Foreground="#CFE6E3" FontSize="12"/>
                                                    <TextBlock Text="clocked in" Foreground="#CFE6E3" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="HeroAvatars" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="#CFE6E3" TextWrapping="Wrap">
                                            <Run x:Name="HeroNotInRun" Text="0" FontWeight="Bold" Foreground="White"/><Run Text=" Not yet in   "/><Run x:Name="HeroOutRun" Text="0" FontWeight="Bold" Foreground="White"/><Run Text=" Clocked out   "/><Run x:Name="HeroRateRun" Text="0%" FontWeight="Bold" Foreground="White"/><Run Text=" Attendance"/>
                                        </TextBlock>
                                        <Border Background="White" CornerRadius="12" Height="42" Margin="0,16,0,0" Padding="12,0">
                                            <Grid>
                                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="{StaticResource CMuted}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"/>
                                                <TextBox x:Name="HeroSearchBox" Style="{StaticResource CSearchBox}" Margin="26,0,0,0"
                                                         TextChanged="HeroSearchBox_TextChanged"/>
                                                <TextBlock x:Name="HeroSearchPlaceholder" Text="Search employee" Margin="26,0,0,0"
                                                           Foreground="{StaticResource CMuted}" FontSize="13" VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Today's status pie -->
                                <Border x:Name="PieCard" Style="{StaticResource CCard}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Today's status" Style="{StaticResource CTitle}"/>
                                            <TextBlock x:Name="PieSubText" Style="{StaticResource CSub}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Canvas x:Name="PieCanvas" Width="132" Height="132"/>
                                            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="#0B4F49" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Still in" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LegendInText" Style="{StaticResource CSub}" Margin="16,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="#2DB7A3" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Clocked out" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LegendOutText" Style="{StaticResource CSub}" Margin="16,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="#F5B71E" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Not yet in" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LegendAbsentText" Style="{StaticResource CSub}" Margin="16,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Key rates -->
                                <Border x:Name="RingsCard" Style="{StaticResource CCard}">
                                    <StackPanel>
                                        <TextBlock Text="Key rates" Style="{StaticResource CTitle}"/>
                                        <TextBlock Text="Attendance • Enrollment • Checked out" Style="{StaticResource CSub}" Margin="0,2,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Grid Width="84" Height="84">
                                                    <Ellipse Width="76" Height="76" Stroke="#EEF2F3" StrokeThickness="9"/>
                                                    <Path x:Name="RingA" Stroke="#0F6B63" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                                    <TextBlock x:Name="RingAText" Text="0%" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Attendance" Style="{StaticResource CSub}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <Grid Width="84" Height="84">
                                                    <Ellipse Width="76" Height="76" Stroke="#EEF2F3" StrokeThickness="9"/>
                                                    <Path x:Name="RingB" Stroke="#F5B71E" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                                    <TextBlock x:Name="RingBText" Text="0%" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Enrolled" Style="{StaticResource CSub}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <Grid Width="84" Height="84">
                                                    <Ellipse Width="76" Height="76" Stroke="#EEF2F3" StrokeThickness="9"/>
                                                    <Path x:Name="RingC" Stroke="#2DB7A3" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                                    <TextBlock x:Name="RingCText" Text="0%" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Checked out" Style="{StaticResource CSub}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Latest activity cards -->
                                <StackPanel x:Name="LiveSection" Margin="8,8,0,0">
                                    <TextBlock Text="Latest activity" Style="{StaticResource CTitle}" Margin="4,0,0,10"/>
                                    <ItemsControl x:Name="LiveList" ItemTemplate="{StaticResource LiveCardTemplate}"/>
                                    <TextBlock x:Name="LiveEmptyText" Text="Employees who clock in will appear here."
                                               Style="{StaticResource CSub}" FontSize="12" Margin="4,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- Analytics chart -->
                                <Border x:Name="ChartCard" Style="{StaticResource CCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Attendance analytics" Style="{StaticResource CTitle}"/>
                                                <TextBlock x:Name="ChartSubText" Style="{StaticResource CSub}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EEF3F3" CornerRadius="10" Padding="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource CSegBtn}" GroupName="ChartRange" Content="Today" Tag="Today" IsChecked="True" Checked="ChartRange_Checked"/>
                                                    <RadioButton Style="{StaticResource CSegBtn}" GroupName="ChartRange" Content="7 days" Tag="7" Checked="ChartRange_Checked"/>
                                                    <RadioButton Style="{StaticResource CSegBtn}" GroupName="ChartRange" Content="30 days" Tag="30" Checked="ChartRange_Checked"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                <Ellipse Width="8" Height="8" Fill="#0B4F49" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ChartLegendAText" Style="{StaticResource CSub}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                <Ellipse Width="8" Height="8" Fill="#2DB7A3" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ChartLegendBText" Style="{StaticResource CSub}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel x:Name="ChartLegendC" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#E3EAEC" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ChartLegendCText" Style="{StaticResource CSub}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Canvas x:Name="ChartCanvas" Height="270" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Time log (today) -->
                                <Border x:Name="TableCard" Style="{StaticResource CCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Time log" Style="{StaticResource CTitle}"/>
                                                <TextBlock Text="Who reported today, when they clocked in and out" Style="{StaticResource CSub}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Style="{StaticResource CGhostBtn}" Content="View all" Click="ViewAll_Click" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource CGhostBtn}" Click="ExportToday_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                        <TextBlock Text="Export" Margin="7,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ContentControl Content="h" ContentTemplate="{StaticResource LogHeaderTemplate}"/>
                                        <ItemsControl x:Name="DashboardLogList" ItemTemplate="{StaticResource LogRowTemplate}"/>
                                        <TextBlock x:Name="DashboardEmptyText" Text="No employees to show yet. Sign-in loads your branch's employee list."
                                                   Style="{StaticResource CSub}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DashboardFooterText" Style="{StaticResource CSub}" Margin="2,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ============ TIME LOG (full page) ============ -->
                        <StackPanel x:Name="AttendancePage" Visibility="Collapsed">
                            <Border Style="{StaticResource CCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Time log" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CInk}"/>
                                            <TextBlock x:Name="PageSummaryText" Style="{StaticResource CSub}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource CGhostBtn}" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Click="PrevDay_Click" ToolTip="Previous day"/>
                                            <TextBlock x:Name="PageDateText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CInk}"
                                                       VerticalAlignment="Center" Margin="12,0" MinWidth="130" TextAlignment="Center"/>
                                            <Button x:Name="PageNextButton" Style="{StaticResource CGhostBtn}" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Click="NextDay_Click" ToolTip="Next day"/>
                                            <Button x:Name="PageTodayButton" Style="{StaticResource CGhostBtn}" Content="Today" Click="TodayDay_Click" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource CGhostBtn}" Click="ExportPage_Click" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                    <TextBlock Text="Export" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#EEF3F3" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource CSegBtn}" GroupName="PageFilter" Content="All" Tag="All" IsChecked="True" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource CSegBtn}" GroupName="PageFilter" Content="In" Tag="In" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource CSegBtn}" GroupName="PageFilter" Content="Out" Tag="Out" Checked="PageFilter_Checked"/>
                                            <RadioButton Style="{StaticResource CSegBtn}" GroupName="PageFilter" Content="Not in" Tag="Absent" Checked="PageFilter_Checked"/>
                                        </StackPanel>
                                    </Border>

                                    <ContentControl Content="h" ContentTemplate="{StaticResource LogHeaderTemplate}"/>
                                    <ItemsControl x:Name="PageLogList" ItemTemplate="{StaticResource LogRowTemplate}"/>
                                    <TextBlock x:Name="PageEmptyText" Text="Nothing to show for this filter."
                                               Style="{StaticResource CSub}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ ENROLL ============ -->
                        <Grid x:Name="EnrollPage" Visibility="Collapsed" MaxWidth="1040" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" MinWidth="300"/>
                                <ColumnDefinition Width="7*" MinWidth="360"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CCard}">
                                <StackPanel>
                                    <TextBlock Text="Select employee" Style="{StaticResource CTitle}"/>
                                    <TextBlock Text="Search your branch roster, then pick who to enroll" Style="{StaticResource CSub}" Margin="0,2,0,12"/>
                                    <Border Background="#F1F5F6" CornerRadius="12" Height="40" Padding="12,0">
                                        <Grid>
                                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{StaticResource CMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <TextBox x:Name="EmployeeSearchBox" Style="{StaticResource CSearchBox}" Margin="26,0,0,0"
                                                     TextChanged="EmployeeSearchBox_TextChanged"/>
                                            <TextBlock x:Name="EmployeeSearchPlaceholder" Text="Type a name or employee number" Margin="26,0,0,0"
                                                       Foreground="{StaticResource CMuted}" FontSize="13" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                    <ListBox x:Name="EmployeeListBox" Margin="0,10,0,0" MinHeight="260" MaxHeight="420"
                                             BorderThickness="0" Background="Transparent"
                                             ItemTemplate="{StaticResource PickerItemTemplate}"
                                             ItemContainerStyle="{StaticResource CListItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="EmployeeListBox_SelectionChanged"/>
                                    <TextBlock x:Name="EmployeeCountText" Style="{StaticResource CSub}" Margin="2,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CCard}" Padding="26">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="BIOMETRIC CAPTURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CMuted}" VerticalAlignment="Center"/>
                                        <Border x:Name="EnrollStagePill" HorizontalAlignment="Right" CornerRadius="999" Padding="10,3" Background="#DDF0EC">
                                            <TextBlock x:Name="EnrollStagePillText" Text="Ready" Foreground="{StaticResource CTeal}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="EnrollTargetText" Text="Select an employee to begin" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource CInk}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>

                                    <Grid Width="220" Height="200" HorizontalAlignment="Center" Margin="0,10,0,4">
                                        <Ellipse x:Name="EnrollPulseRing" Width="180" Height="180" Stroke="#660F6B63" StrokeThickness="2"
                                                 Fill="#140F6B63" RenderTransformOrigin="0.5,0.5" Visibility="Hidden">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="EnrollPulseScale"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Border Width="128" Height="146" CornerRadius="16" BorderBrush="#CC334155" BorderThickness="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#0F172A" Offset="0"/>
                                                    <GradientStop Color="#0B3A35" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border Margin="8" CornerRadius="10" Background="#06201D" BorderBrush="#662DB7A3" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock x:Name="EnrollFingerGlyph" Text="&#xE928;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="58" Foreground="#6EE7D2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border x:Name="EnrollLaser" Height="3" VerticalAlignment="Top" Visibility="Hidden">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#006EE7D2" Offset="0"/>
                                                                <GradientStop Color="#FF6EE7D2" Offset="0.5"/>
                                                                <GradientStop Color="#006EE7D2" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="EnrollLaserTranslate"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="EnrollHeadlineText" Text="Ready to enroll" FontSize="17" FontWeight="ExtraBold"
                                               Foreground="{StaticResource CInk}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Name="EnrollSubtext" Text="Select an employee, then press Enroll Fingerprint."
                                               Style="{StaticResource CSub}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               MaxWidth="380" Margin="0,4,0,0" HorizontalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step1Circle" Width="22" Height="22" CornerRadius="11">
                                                <TextBlock x:Name="Step1Text" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="Step1Label" Text="Select" FontSize="12" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Width="24" Height="2" Background="#E2E8F0" Margin="10,0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step2Circle" Width="22" Height="22" CornerRadius="11">
                                                <TextBlock x:Name="Step2Text" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="Step2Label" Text="Scan" FontSize="12" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Width="24" Height="2" Background="#E2E8F0" Margin="10,0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step3Circle" Width="22" Height="22" CornerRadius="11">
                                                <TextBlock x:Name="Step3Text" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="Step3Label" Text="Register" FontSize="12" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border BorderBrush="{StaticResource CLine}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                                        <Grid>
                                            <TextBlock Text="Sensor: SecuGen optical" Style="{StaticResource CSub}" VerticalAlignment="Center"/>
                                            <Button x:Name="EnrollButton" Style="{StaticResource CPrimaryBtn}" HorizontalAlignment="Center" Click="EnrollButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Enroll Fingerprint" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="EnrollSensorText" Text="Checking…" FontSize="11" FontWeight="Bold" Foreground="#059669"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ DEVICE ============ -->
                        <StackPanel x:Name="DevicePage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CCard}">
                                <StackPanel>
                                    <TextBlock Text="Device &amp; sync" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CInk}"/>
                                    <TextBlock Text="Fingerprint reader health and data waiting to reach the server" Style="{StaticResource CSub}" Margin="0,3,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Fingerprint reader" Style="{StaticResource CSub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DevReaderText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="0,8"/>
                                        <TextBlock Grid.Row="1" Text="Serial number" Style="{StaticResource CSub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevSerialText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="0,8"/>
                                        <TextBlock Grid.Row="2" Text="Fingerprints enrolled" Style="{StaticResource CSub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DevEnrolledText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="0,8"/>
                                        <TextBlock Grid.Row="3" Text="Employees on this branch" Style="{StaticResource CSub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DevEmployeesText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="0,8"/>
                                        <TextBlock Grid.Row="4" Text="Scans waiting to sync" Style="{StaticResource CSub}" FontSize="12" Margin="0,8"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DevPendingText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}" Margin="0,8"/>
                                    </Grid>
                                    <Button Content="Refresh" Style="{StaticResource CGhostBtn}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RefreshDevice_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ DAMAGES ============ -->
                        <local:DaysWorkedView x:Name="DaysWorkedPage" Visibility="Collapsed" MaxWidth="1040" HorizontalAlignment="Center"/>
                        <local:DamagesView x:Name="DamagesPage" Visibility="Collapsed" MaxWidth="1040" HorizontalAlignment="Center"/>

                        <!-- ============ HELP ============ -->
                        <StackPanel x:Name="HelpPage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CCard}">
                                <StackPanel>
                                    <TextBlock Text="Help center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CInk}" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource CInk}" FontSize="12" LineHeight="20">
                                        <Run FontWeight="Bold" Text="Clocking in / out"/><LineBreak/>
                                        <Run Text="Employees place an enrolled finger on the reader at the kiosk screen. No login is needed. The first scan of the day clocks in; the next clocks out. Hold still until the name appears, then lift."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="Bold" Text="Reading the Time log"/><LineBreak/>
                                        <Run Text="Every employee on the branch is listed. IN = on shift, OUT = finished, NOT IN YET = has not reported, NOT ENROLLED = no fingerprint yet. Hover a row to see every punch."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="Bold" Text="Enrolling someone"/><LineBreak/>
                                        <Run Text="Open Enroll Employee, search and pick the person, press Enroll Fingerprint and have them place their finger on the reader."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="Bold" Text="Back to the kiosk"/><LineBreak/>
                                        <Run Text="Use Sign out in the sidebar. The console also locks itself after 3 minutes without activity. Scanning keeps running the whole time."/><LineBreak/><LineBreak/>
                                        <Run FontWeight="Bold" Text="Working offline"/><LineBreak/>
                                        <Run Text="Scans are saved on this computer and sync automatically when the connection returns. Signing in and enrolling need a connection."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Notifications popup (bell) -->
        <Popup x:Name="NotifyPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
               HorizontalOffset="-250" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="294" Background="White" BorderBrush="{StaticResource CLine}" BorderThickness="1" CornerRadius="14"
                    Padding="16" Margin="8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.16" BlurRadius="24" ShadowDepth="6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource CTitle}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="NotifyList"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Toast -->
        <Border x:Name="ToastBorder" Visibility="Collapsed" CornerRadius="10" Padding="16,11"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="460">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>