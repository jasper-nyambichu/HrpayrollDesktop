<UserControl x:Class="HrpayrollDesktop.DamagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="DamageRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AmountText}" Foreground="#8A5F00" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <Border Background="{Binding StatusBg}" CornerRadius="8" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!-- ================= HEADER ================= -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Damages" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Every damage at this branch. Record one, the employee agrees by fingerprint (or you override with a reason), and the Admin's payment calculation deducts it."
                               Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,16,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Style="{StaticResource GhostBtn}" Content="Refresh" Margin="0,0,8,0"
                            Click="RefreshButton_Click"/>
                    <Button x:Name="RecordToggleButton" Style="{StaticResource PrimaryBtn}" Content="Record damage"
                            Click="RecordToggleButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= RECORD FORM ================= -->
        <Border x:Name="RecordCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Record a damage" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="It stays unapproved (nothing is deducted) until the employee agrees or you override."
                           Style="{StaticResource Sub}" Margin="0,2,0,4"/>

                <TextBlock Text="EMPLOYEE" Style="{StaticResource FieldLabel}"/>
                <!-- Only the employee's name, in the list and once chosen. -->
                <ComboBox x:Name="EmployeeCombo" Height="38" FontSize="13" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="AMOUNT (KES)" Style="{StaticResource FieldLabel}"/>
                <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="10" Height="38" Padding="12,0">
                    <TextBox x:Name="AmountBox" Style="{StaticResource InputBox}"/>
                </Border>

                <TextBlock Text="WHAT HAPPENED" Style="{StaticResource FieldLabel}"/>
                <Border Background="{StaticResource SurfaceLowBrush}" CornerRadius="10" Height="78" Padding="12,8">
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource InputBox}" AcceptsReturn="True"
                             TextWrapping="Wrap" MaxLength="500" VerticalContentAlignment="Top"/>
                </Border>

                <TextBlock x:Name="RecordErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="RecordSaveButton" Style="{StaticResource PrimaryBtn}" Content="Save damage"
                            Click="RecordSaveButton_Click"/>
                    <Button Style="{StaticResource GhostBtn}" Content="Close" Margin="8,0,0,0" Click="RecordCloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= LIST + DETAIL ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300"/>
                <ColumnDefinition Width="7*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="All damages" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Newest first, with where each one stands" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="StatusFilter" Grid.Column="1" Width="170" Height="36" VerticalAlignment="Center"
                                  SelectionChanged="StatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All damages" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Awaiting consent" Tag="PENDING_CONSENT"/>
                            <ComboBoxItem Content="Approved, to deduct" Tag="APPROVED"/>
                            <ComboBoxItem Content="Deducted" Tag="DEDUCTED"/>
                            <ComboBoxItem Content="Cancelled" Tag="CANCELLED"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="TotalsText" Style="{StaticResource Sub}" Margin="0,8,0,10" TextWrapping="Wrap"/>
                    <ListBox x:Name="DamageList" MinHeight="260" MaxHeight="420" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource DamageRowTemplate}"
                             ItemContainerStyle="{StaticResource ListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="DamageList_SelectionChanged"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Sub}" Margin="2,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="26">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText" Text="Select a damage to see where it stands. One awaiting consent can be approved by fingerprint, overridden or cancelled."
                               Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <TextBlock Text="DAMAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="DetailNameText" Style="{StaticResource PageTitle}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DetailSubText" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="DetailAmountText" FontSize="26" FontWeight="Bold" Foreground="#8A5F00" Margin="0,14,0,0"/>
                        <TextBlock x:Name="DetailDescriptionText" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DetailDateText" Style="{StaticResource Sub}" Margin="0,6,0,0"/>

                        <!-- Where the damage stands, including whether the Admin's payment calculation deducted it -->
                        <Border x:Name="StateBox" CornerRadius="12" Padding="14,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="StateTitleText" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="StateDetailText" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fingerprint status (only for a damage awaiting consent) -->
                        <Border x:Name="StatusBox" Background="#F0F4F8" CornerRadius="12" Padding="14,12" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource BlueBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Press the button, then ask the employee to place their finger on the reader."
                                           FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" MaxWidth="360"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ActionRow" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="CaptureButton" Style="{StaticResource PrimaryBtn}" Content="Capture fingerprint"
                                    Click="CaptureButton_Click"/>
                            <Button x:Name="StopCaptureButton" Style="{StaticResource GhostBtn}" Content="Stop" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="StopCaptureButton_Click"/>
                            <Button x:Name="OverrideButton" Style="{StaticResource GhostBtn}" Content="Override…" Margin="8,0,0,0"
                                    Click="OverrideButton_Click"/>
                            <Button x:Name="CancelDamageButton" Style="{StaticResource GhostBtn}" Content="Cancel damage" Margin="8,0,0,0"
                                    Click="CancelDamageButton_Click"/>
                        </StackPanel>

                        <!-- Override -->
                        <Border x:Name="OverridePanel" Visibility="Collapsed" Background="#FFF4D6" BorderBrush="#F2D58A"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Override fingerprint consent" FontSize="13" FontWeight="Bold" Foreground="#8A5F00"/>
                                <TextBlock Text="This approves the damage without the employee's fingerprint. The override is recorded with your name and your reason, and stays flagged permanently."
                                           FontSize="11" Foreground="#8A5F00" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Border Background="White" BorderBrush="#F2D58A" BorderThickness="1" CornerRadius="10" Height="70" Padding="12,8">
                                    <TextBox x:Name="ReasonBox" Style="{StaticResource InputBox}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MaxLength="500" VerticalContentAlignment="Top"/>
                                </Border>
                                <TextBlock x:Name="ReasonErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"
                                           Text="Give a reason of at least 10 characters."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ConfirmOverrideButton" Style="{StaticResource DangerBtn}" Content="Approve by override"
                                            Click="ConfirmOverrideButton_Click"/>
                                    <Button Style="{StaticResource GhostBtn}" Content="Back" Margin="8,0,0,0" Click="OverrideBackButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
