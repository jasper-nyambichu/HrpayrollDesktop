<UserControl x:Class="HrpayrollDesktop.DamagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="CTeal" Color="#0F6B63"/>
        <SolidColorBrush x:Key="CInk" Color="#10302D"/>
        <SolidColorBrush x:Key="CMuted" Color="#7C8B8A"/>
        <SolidColorBrush x:Key="CLine" Color="#E6EDEF"/>

        <Style x:Key="DCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="DTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
        </Style>
        <Style x:Key="DSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CMuted}"/>
        </Style>
        <Style x:Key="DLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CMuted}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style x:Key="DGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CLine}" BorderThickness="1"
                                CornerRadius="10" Padding="13,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F8F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CTeal}" CornerRadius="12" Padding="22,11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B5750"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DDangerBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#C2410C" CornerRadius="12" Padding="22,11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9A3412"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless text box (the surrounding Border supplies the look) -->
        <Style x:Key="DInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CInk}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Padding="10,8" Margin="0,0,0,2" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F6F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDF0EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DamageRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CInk}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource DSub}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="#B45309" FontSize="12"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!-- ================= HEADER ================= -->
        <Border Style="{StaticResource DCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Damages" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CInk}"/>
                    <TextBlock Text="Record a damage, then the employee agrees by fingerprint on this reader. If that is not possible, override with a reason."
                               Style="{StaticResource DSub}" TextWrapping="Wrap" Margin="0,3,16,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Style="{StaticResource DGhostBtn}" Content="Refresh" Margin="0,0,8,0"
                            Click="RefreshButton_Click"/>
                    <Button x:Name="RecordToggleButton" Style="{StaticResource DPrimaryBtn}" Content="Record damage"
                            Click="RecordToggleButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= RECORD FORM ================= -->
        <Border x:Name="RecordCard" Style="{StaticResource DCard}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Record a damage" Style="{StaticResource DTitle}"/>
                <TextBlock Text="It stays unapproved (nothing is deducted) until the employee agrees or you override."
                           Style="{StaticResource DSub}" Margin="0,2,0,4"/>

                <TextBlock Text="EMPLOYEE" Style="{StaticResource DLabel}"/>
                <ComboBox x:Name="EmployeeCombo" DisplayMemberPath="FullName" Height="38" FontSize="13"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="AMOUNT (KES)" Style="{StaticResource DLabel}"/>
                <Border Background="#F1F5F6" CornerRadius="10" Height="38" Padding="12,0">
                    <TextBox x:Name="AmountBox" Style="{StaticResource DInputBox}"/>
                </Border>

                <TextBlock Text="WHAT HAPPENED" Style="{StaticResource DLabel}"/>
                <Border Background="#F1F5F6" CornerRadius="10" Height="78" Padding="12,8">
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource DInputBox}" AcceptsReturn="True"
                             TextWrapping="Wrap" MaxLength="500" VerticalContentAlignment="Top"/>
                </Border>

                <TextBlock x:Name="RecordErrorText" Foreground="#C2410C" FontSize="12" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="RecordSaveButton" Style="{StaticResource DPrimaryBtn}" Content="Save damage"
                            Click="RecordSaveButton_Click"/>
                    <Button Style="{StaticResource DGhostBtn}" Content="Close" Margin="8,0,0,0" Click="RecordCloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= LIST + DETAIL ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300"/>
                <ColumnDefinition Width="7*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DCard}">
                <StackPanel>
                    <TextBlock Text="Awaiting consent" Style="{StaticResource DTitle}"/>
                    <TextBlock Text="Damages at this branch that no one has agreed to yet" Style="{StaticResource DSub}" Margin="0,2,0,10"/>
                    <ListBox x:Name="DamageList" MinHeight="260" MaxHeight="420" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource DamageRowTemplate}"
                             ItemContainerStyle="{StaticResource DListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="DamageList_SelectionChanged"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource DSub}" Margin="2,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource DCard}" Padding="26">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText" Text="Select a damage to approve it, override it or cancel it."
                               Style="{StaticResource DSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <TextBlock Text="DAMAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CMuted}"/>
                        <TextBlock x:Name="DetailNameText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CInk}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DetailSubText" Style="{StaticResource DSub}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="DetailAmountText" FontSize="26" FontWeight="Bold" Foreground="#B45309" Margin="0,14,0,0"/>
                        <TextBlock x:Name="DetailDescriptionText" FontSize="12" Foreground="{StaticResource CInk}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DetailDateText" Style="{StaticResource DSub}" Margin="0,6,0,0"/>

                        <!-- Fingerprint status -->
                        <Border x:Name="StatusBox" Background="#F1F6F6" CornerRadius="12" Padding="14,12" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource CTeal}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Press the button, then ask the employee to place their finger on the reader."
                                           FontSize="12" Foreground="{StaticResource CInk}" TextWrapping="Wrap" MaxWidth="360"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ActionRow" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="CaptureButton" Style="{StaticResource DPrimaryBtn}" Content="Capture fingerprint"
                                    Click="CaptureButton_Click"/>
                            <Button x:Name="StopCaptureButton" Style="{StaticResource DGhostBtn}" Content="Stop" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="StopCaptureButton_Click"/>
                            <Button x:Name="OverrideButton" Style="{StaticResource DGhostBtn}" Content="Override…" Margin="8,0,0,0"
                                    Click="OverrideButton_Click"/>
                            <Button x:Name="CancelDamageButton" Style="{StaticResource DGhostBtn}" Content="Cancel damage" Margin="8,0,0,0"
                                    Click="CancelDamageButton_Click"/>
                        </StackPanel>

                        <!-- Override -->
                        <Border x:Name="OverridePanel" Visibility="Collapsed" Background="#FFF7ED" BorderBrush="#FED7AA"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Override fingerprint consent" FontSize="13" FontWeight="Bold" Foreground="#9A3412"/>
                                <TextBlock Text="This approves the damage without the employee's fingerprint. The override is recorded with your name and your reason, and stays flagged permanently."
                                           FontSize="11" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Border Background="White" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Height="70" Padding="12,8">
                                    <TextBox x:Name="ReasonBox" Style="{StaticResource DInputBox}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MaxLength="500" VerticalContentAlignment="Top"/>
                                </Border>
                                <TextBlock x:Name="ReasonErrorText" Foreground="#C2410C" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"
                                           Text="Give a reason of at least 10 characters."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ConfirmOverrideButton" Style="{StaticResource DDangerBtn}" Content="Approve by override"
                                            Click="ConfirmOverrideButton_Click"/>
                                    <Button Style="{StaticResource DGhostBtn}" Content="Back" Margin="8,0,0,0" Click="OverrideBackButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
