<UserControl x:Class="HrpayrollDesktop.DaysWorkedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="DaysRowTemplate">
            <Border BorderBrush="#E9EFF5" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Number}" Style="{StaticResource Sub}" FontSize="10"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding Days}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Sub}" TextWrapping="Wrap"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!-- ================= HEADER ================= -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Days worked" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="The days each employee clocked in during the pay period, counted from attendance. Nothing needs locking: the Admin's payment calculation uses these figures whenever it is run."
                           Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ================= PERIOD ================= -->
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="FROM" Style="{StaticResource TableHead}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromPicker" Width="150" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="TO" Style="{StaticResource TableHead}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToPicker" Width="150" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button x:Name="ShowButton" Style="{StaticResource PrimaryBtn}" Content="Show" VerticalAlignment="Bottom"
                        Click="ShowButton_Click"/>
                <TextBlock x:Name="PeriodErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" VerticalAlignment="Bottom"
                           Margin="14,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>

        <!-- ================= TABLE ================= -->
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
                <TextBlock x:Name="TableTitleText" Text="Employees" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TableSubText" Style="{StaticResource Sub}" Margin="0,2,0,0"/>

                <TextBlock x:Name="EmptyText" Text="Choose the pay period and press Show." Style="{StaticResource Sub}"
                           FontSize="12" Margin="0,16,0,0"/>

                <StackPanel x:Name="TablePanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EMPLOYEE" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="1" Text="DAYS WORKED" Style="{StaticResource TableHead}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="NOTE" Style="{StaticResource TableHead}" Margin="12,0,0,0"/>
                    </Grid>

                    <ItemsControl x:Name="RowsControl" ItemTemplate="{StaticResource DaysRowTemplate}"/>

                    <TextBlock x:Name="TotalText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,18,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
