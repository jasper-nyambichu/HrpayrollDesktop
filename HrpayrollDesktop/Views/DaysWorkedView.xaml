<UserControl x:Class="HrpayrollDesktop.DaysWorkedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="DaysRowTemplate">
            <Border BorderBrush="#E9EFF5" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Number}" Style="{StaticResource Sub}" FontSize="10"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding SystemDays}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Border Grid.Column="2" Width="84" Height="34" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{Binding DaysBackground}" Padding="8,0">
                        <TextBox Text="{Binding DaysText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Editable}" Style="{StaticResource InputBox}" TextAlignment="Center"
                                 MaxLength="3"/>
                    </Border>

                    <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Visibility="{Binding ReasonVisibility}" Background="{StaticResource SurfaceLowBrush}" CornerRadius="8" Height="34" Padding="10,0">
                            <TextBox Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" MaxLength="500"/>
                        </Border>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!-- ================= HEADER ================= -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Days worked" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Review each employee's days for the pay period, correct any with a reason, then lock them. Payroll only uses locked figures."
                           Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ================= PERIOD ================= -->
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="FROM" Style="{StaticResource TableHead}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromPicker" Width="150" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="TO" Style="{StaticResource TableHead}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToPicker" Width="150" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button x:Name="ShowButton" Style="{StaticResource PrimaryBtn}" Content="Show" VerticalAlignment="Bottom"
                        Click="ShowButton_Click"/>
                <TextBlock x:Name="PeriodErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" VerticalAlignment="Bottom"
                           Margin="14,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>

        <!-- ================= TABLE ================= -->
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TableTitleText" Text="Employees" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="TableSubText" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="LockedPill" Grid.Column="1" Background="#E5F4E2" CornerRadius="10" Padding="12,5"
                            Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="Locked" FontSize="11" FontWeight="Bold" Foreground="#2E7D24"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="EmptyText" Text="Choose the pay period and press Show." Style="{StaticResource Sub}"
                           FontSize="12" Margin="0,16,0,0"/>

                <StackPanel x:Name="TablePanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EMPLOYEE" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="1" Text="FROM ATTENDANCE" Style="{StaticResource TableHead}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="DAYS WORKED" Style="{StaticResource TableHead}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="REASON FOR CHANGE" Style="{StaticResource TableHead}" Margin="12,0,0,0"/>
                    </Grid>

                    <ItemsControl x:Name="RowsControl" ItemTemplate="{StaticResource DaysRowTemplate}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TotalText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="HintText" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,16,0"/>
                        </StackPanel>
                        <Button x:Name="LockButton" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Content="Lock days for payroll"
                                Click="LockButton_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
