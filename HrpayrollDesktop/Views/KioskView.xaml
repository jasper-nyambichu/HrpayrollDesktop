<UserControl x:Class="HrpayrollDesktop.KioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HrpayrollDesktop">
    <UserControl.Resources>
        <DataTemplate x:Key="ActivityRow">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Line}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One of the three "how your day works" cards under the scanner -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource ShadowSoft}"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BlueFixedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border CornerRadius="18" Background="{StaticResource SidebarGradient}" Padding="14,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Width="84" Height="84" CornerRadius="20" Background="White" Padding="9" HorizontalAlignment="Center"
                        Margin="0,4,0,28" Effect="{StaticResource ShadowMid}">
                    <Image Source="/Assets/dhwarsh-mark.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Row="1">
                    <ToggleButton Style="{StaticResource NavBtn}" IsChecked="True" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Attendance" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="NavActivityButton" Style="{StaticResource NavActionBtn}" Click="SeeAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE889;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Today's activity" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSyncButton" Style="{StaticResource NavActionBtn}" Click="SyncStatus_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE627;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Sync status" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHelpButton" Style="{StaticResource NavActionBtn}" Click="Help_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="How it works" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <!-- Branch Manager only: check staff in by hand when the reader fails -->
                    <Button x:Name="ManualCheckInButton" Style="{StaticResource NavActionBtn}" Click="ManualCheckInButton_Click"
                            ToolTip="Branch Manager: check employees in by hand when the fingerprint reader fails">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE174;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Manual check-in" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ManagerLoginButton" Style="{StaticResource NavActionBtn}" Click="ManagerLoginButton_Click" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA77;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Back Office login" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Page ===== -->
        <Grid Grid.Column="1" Margin="16,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: the date on the left; sync, reader and branch on the right -->
            <Grid Margin="0,4,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fingerprint attendance" Style="{StaticResource PageTitle}" FontSize="18"/>
                    <TextBlock x:Name="LiveDateText" Style="{StaticResource Sub}" Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SyncPill" Style="{StaticResource StatusPillBtn}" Background="{StaticResource BlueSoftBrush}" Margin="0,0,8,0"
                            Click="SyncStatus_Click" ToolTip="See what has reached the server">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SyncIcon" Text="&#xE627;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock x:Name="SyncText" Text="Checking sync…" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource BlueBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="ReaderPill" CornerRadius="15" Padding="12,7" Background="{StaticResource AmberSoftBrush}" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FooterStatusDot" Width="8" Height="8" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FooterStatusText" Text="Connecting to reader…" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource AmberInkBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BlueFixedBrush}">
                        <TextBlock Text="&#xE8D1;" Style="{StaticResource Icon}" FontSize="21" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="200">
                        <TextBlock x:Name="BranchNameText" Text="Attendance terminal" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StationLabelText" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SideColumn" Width="280"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== The scanner ===== -->
                    <Border CornerRadius="22" Background="{StaticResource ScannerGradient}" ClipToBounds="True" MinHeight="300" Effect="{StaticResource ShadowMid}">
                        <Grid>
                            <!-- Faint rings and a grid of dots give the light panel depth -->
                            <Ellipse Width="620" Height="620" Stroke="#221C6EB4" StrokeThickness="1" IsHitTestVisible="False"/>
                            <Ellipse Width="460" Height="460" Stroke="#2E1C6EB4" StrokeThickness="1" IsHitTestVisible="False"/>
                            <Rectangle IsHitTestVisible="False" Opacity="0.5">
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#5593A9C2">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,26,26"/>
                                                        <EllipseGeometry Center="13,13" RadiusX="1" RadiusY="1"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.3"/>
                                        <GradientStop Color="#FF000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>

                            <Grid Margin="28,22,28,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Greeting and clock; what the reader is doing on the right -->
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="GreetingText" Text="Good morning!" FontSize="13" FontWeight="Medium" Foreground="{StaticResource ScannerMutedBrush}"/>
                                        <TextBlock x:Name="LiveClockText" FontSize="34" LineHeight="40" FontWeight="SemiBold" Foreground="{StaticResource ScannerInkBrush}"/>
                                    </StackPanel>
                                    <Border x:Name="ScannerChip" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="13" Padding="11,5"
                                            Background="#1A0891B2" BorderBrush="#400891B2" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ScannerChipDot" Width="7" Height="7" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ScannerChipText" Text="Ready" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ScannerInkBrush}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- The fingerprint: touching it does the same as the button -->
                                <local:FingerprintScanner x:Name="Scanner" Grid.Row="1" Margin="0,4" MaxWidth="330" MaxHeight="330" MinHeight="140"
                                                          Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Scanner_MouseLeftButtonUp"
                                                          ToolTip="Scan fingerprint"/>

                                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,14">
                                    <TextBlock x:Name="ScanStatusTitle" Text="Place your finger on the reader" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource ScannerInkBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Name="ScanStatusSub" Text="One scan checks you in, starts a break, brings you back, or checks you out."
                                               FontSize="12" Foreground="{StaticResource ScannerMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="460" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button x:Name="ScanButton" Grid.Row="3" Style="{StaticResource NeonBtn}" HorizontalAlignment="Center" Click="Scan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}" FontSize="19" Foreground="{StaticResource BlueBrush}"/>
                                        <TextBlock Text="Scan fingerprint" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===== How a day works ===== -->
                    <Grid x:Name="StepsRow" Grid.Row="1" Margin="0,14,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource StepCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/3D/clock.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="1  ·  Check in" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Scan when you arrive. You must check in first." FontSize="11" Foreground="{StaticResource InkSoftBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StepCard}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/3D/lunch.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="2  ·  During the day" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Lunch is 30 minutes. A temporary check-out: type the minutes you need."
                                               FontSize="11" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource StepCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/3D/briefcase.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="3  ·  Check out" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Scan, then choose &quot;Check out for the day&quot;." FontSize="11" Foreground="{StaticResource InkSoftBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Right column ===== -->
                <Grid x:Name="SidePanel" Grid.Column="1" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Today's figures -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="8,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="/Assets/3D/people.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="StatAtWork" Text="0" FontSize="20" LineHeight="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="At work" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Fill="{StaticResource LineBrush}" Margin="0,6"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Image Source="/Assets/3D/hourglass.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="StatOnBreak" Text="0" FontSize="20" LineHeight="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="On a break" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Fill="{StaticResource LineBrush}" Margin="0,6"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <Image Source="/Assets/3D/door.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="StatLeft" Text="0" FontSize="20" LineHeight="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Checked out" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="At work now" Style="{StaticResource SectionTitle}"/>
                    <Button Grid.Row="1" Style="{StaticResource LinkBtn}" Content="See all" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SeeAll_Click"/>
                    <Grid Grid.Row="2" Margin="0,10,0,16" MinHeight="50">
                        <StackPanel x:Name="AtWorkAvatars" Orientation="Horizontal"/>
                        <TextBlock x:Name="AtWorkEmpty" Text="Nobody has checked in yet." Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Today's activity" Style="{StaticResource SectionTitle}"/>
                    <Button Grid.Row="3" Style="{StaticResource LinkBtn}" Content="See all" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SeeAll_Click"/>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,4" Padding="16,16,16,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ActivityRow}"/>
                                <TextBlock x:Name="RecentEmptyText" Text="No scans yet today. The first person to check in will appear here."
                                           Style="{StaticResource Sub}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
