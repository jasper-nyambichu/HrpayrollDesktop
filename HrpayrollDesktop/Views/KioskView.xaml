<UserControl x:Class="HrpayrollDesktop.KioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ActivityRow">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding AvatarBg}">
                    <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Line}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border CornerRadius="18" Background="{StaticResource SidebarGradient}" Padding="14,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Width="84" Height="84" CornerRadius="20" Background="White" Padding="9" HorizontalAlignment="Center"
                        Margin="0,4,0,28" Effect="{StaticResource ShadowMid}">
                    <Image Source="/Assets/dhwarsh-mark.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Row="1">
                    <ToggleButton Style="{StaticResource NavBtn}" IsChecked="True" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE871;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Attendance" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="NavActivityButton" Style="{StaticResource NavActionBtn}" Click="SeeAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE889;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Today's activity" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHelpButton" Style="{StaticResource NavActionBtn}" Click="Help_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="How it works" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="ManagerLoginButton" Grid.Row="2" Style="{StaticResource NavActionBtn}" Click="ManagerLoginButton_Click" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA77;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Back Office login" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Page ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,0,0">
            <Grid Margin="8,0,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top row: the clock where the design has its search box, and this reader on the right -->
                <Grid Margin="0,4,0,16">
                    <Border HorizontalAlignment="Left" Height="44" CornerRadius="22" Background="White" Padding="16,0" Effect="{StaticResource ShadowSoft}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="19" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock x:Name="LiveClockText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="ReaderPill" CornerRadius="15" Padding="12,7" Background="{StaticResource AmberSoftBrush}" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="FooterStatusDot" Width="8" Height="8" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FooterStatusText" Text="Connecting to reader…" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource AmberInkBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource BlueFixedBrush}">
                            <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BranchNameText" Text="Attendance terminal" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="StationLabelText" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="SideColumn" Width="270"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- Banner -->
                        <Border CornerRadius="18" Background="{StaticResource HeroGradient}" Height="196" ClipToBounds="True">
                            <Grid>
                                <Ellipse Width="16" Height="16" Fill="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,274,0"/>
                                <Ellipse Width="11" Height="11" Fill="#9CD84F" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,300,34"/>
                                <Ellipse Width="20" Height="20" Fill="#9FCAFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,44,0"/>

                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="280" Height="196" IsHitTestVisible="False">
                                    <Image x:Name="HeroWorker" Source="/Assets/3D/worker.png" Width="196" Height="196" Canvas.Left="62" Canvas.Top="22"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Image Source="/Assets/3D/clock.png" Width="66" Height="66" Canvas.Left="10" Canvas.Top="60"
                                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform><TranslateTransform x:Name="FloatA"/></Image.RenderTransform>
                                    </Image>
                                    <Image Source="/Assets/3D/briefcase.png" Width="56" Height="56" Canvas.Left="222" Canvas.Top="108"
                                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform><TranslateTransform x:Name="FloatB"/></Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <StackPanel Margin="28,0,300,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveDateText" FontSize="11" Foreground="#D2E4FF"/>
                                    <TextBlock x:Name="GreetingText" Text="Good morning!" FontSize="22" LineHeight="32" FontWeight="Bold" Foreground="White" Margin="0,16,0,0"/>
                                    <TextBlock Text="Scan your finger to check in, go on a break, come back, or check out for the day."
                                               FontSize="12" LineHeight="18" Foreground="#E6F0F8" TextWrapping="Wrap" Margin="0,2,0,12"/>
                                    <Button x:Name="ScanButton" Style="{StaticResource HeroBtn}" HorizontalAlignment="Left" Click="Scan_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE90D;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Scan fingerprint" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Figures -->
                        <TextBlock Text="Today" Style="{StaticResource SectionTitle}" Margin="0,18,0,4"/>
                        <Grid Margin="-8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="/Assets/3D/people.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="StatAtWork" Text="0" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="At work" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="/Assets/3D/lunch.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="StatOnBreak" Text="0" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="On a break" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="/Assets/3D/door.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="StatLeft" Text="0" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Checked out" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- What the options mean -->
                        <TextBlock Text="Leaving during the day?" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="14" Background="{StaticResource TintGradient}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1.5" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Lunch break" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="30 minutes. Scan out, and scan again when you return." FontSize="11" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Image Grid.Column="1" Source="/Assets/3D/hourglass.png" Width="52" Height="52" Margin="10,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource BlueFixedBrush}" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Temporary check-out" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="An emergency. Give a reason and your return time." FontSize="11" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Image Grid.Column="1" Source="/Assets/3D/calendar.png" Width="52" Height="52" Margin="10,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Right column -->
                    <Grid x:Name="SidePanel" Grid.Column="1" Margin="18,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="At work now" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource LinkBtn}" Content="See all" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SeeAll_Click"/>
                        <Grid Grid.Row="1" Margin="0,10,0,16" MinHeight="54">
                            <StackPanel x:Name="AtWorkAvatars" Orientation="Horizontal"/>
                            <TextBlock x:Name="AtWorkEmpty" Text="Nobody has checked in yet." Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="Today's activity" Style="{StaticResource SectionTitle}"/>
                        <Button Grid.Row="2" Style="{StaticResource LinkBtn}" Content="See all" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SeeAll_Click"/>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,8" Padding="16,16,16,6" VerticalAlignment="Stretch">
                            <StackPanel>
                                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ActivityRow}"/>
                                <TextBlock x:Name="RecentEmptyText" Text="No scans yet today. The first person to check in will appear here."
                                           Style="{StaticResource Sub}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
