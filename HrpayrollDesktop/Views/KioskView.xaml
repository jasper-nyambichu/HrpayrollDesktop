<UserControl x:Class="HrpayrollDesktop.KioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{StaticResource AppFont}"
             Background="#0B192C">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="KioskGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KioskAmberButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B192C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="28,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F5821F" Offset="0"/>
                                    <GradientStop Color="#E06D0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#071526" Offset="0"/>
                <GradientStop Color="#0B192C" Offset="0.45"/>
                <GradientStop Color="#102A43" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Ambient glows (radial gradients: cheap, no blur effect needed) -->
        <Ellipse Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-260,-260,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#331C6EB4" Offset="0"/>
                    <GradientStop Color="#001C6EB4" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-260,-260" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2B0061A5" Offset="0"/>
                    <GradientStop Color="#000061A5" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#66081321">
                <Grid Margin="32,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" Background="#1AFFFFFF" CornerRadius="10"
                                BorderBrush="#33FFFFFF" BorderThickness="1" Padding="5">
                            <Image Source="/Assets/dhwarsh-logo.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Dhwarsh HR" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="StationLabelText" Text="Biometric Attendance Terminal"
                                       Foreground="#8FA6C2" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LiveClockText" Text="08:14:32" Foreground="White" FontSize="26"
                                       FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveAmPmText" Text="AM" Foreground="#9FCAFF" FontSize="12"
                                       FontWeight="SemiBold" Margin="6,6,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Height="30" Background="#26FFFFFF" Margin="18,0"/>
                        <TextBlock x:Name="LiveDateText" Text="Monday, 28 September 2026" Foreground="#8FA6C2"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Central stage (scales down on small screens, never up) ===== -->
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
                <Grid x:Name="StageHost" MinWidth="760">

                    <!-- IDLE -->
                    <StackPanel x:Name="IdlePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="330" Height="330" HorizontalAlignment="Center" Margin="0,0,0,30">
                            <Ellipse Width="330" Height="330" Stroke="#332C6FBB" StrokeThickness="1"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="IdlePulseScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="280" Height="280" Stroke="#4D2C6FBB" StrokeThickness="1" StrokeDashArray="4 3"/>
                            <Border Width="220" Height="220" CornerRadius="110" BorderThickness="3" BorderBrush="#802C6FBB">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#102B47" Offset="0"/>
                                        <GradientStop Color="#0A1A2E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="100"
                                           Foreground="#7DC4F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Place your finger on the reader" Foreground="White" FontSize="32"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="to clock in or out" Foreground="#8FA6C2" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- SCANNING -->
                    <StackPanel x:Name="ScanningPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Grid Width="330" Height="330" HorizontalAlignment="Center" Margin="0,0,0,26">
                            <!-- radar waves -->
                            <Ellipse x:Name="Wave1" Width="230" Height="230" Stroke="#339FCAFF" StrokeThickness="1.5"
                                     RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Wave1Scale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Wave2" Width="230" Height="230" Stroke="#400061A5" StrokeThickness="1.5"
                                     RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Wave2Scale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- soft halo -->
                            <Ellipse Width="270" Height="270" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#401C6EB4" Offset="0"/>
                                        <GradientStop Color="#001C6EB4" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- scanner chamber -->
                            <Grid Width="220" Height="220">
                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="1">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#13304C" Offset="0"/>
                                            <GradientStop Color="#0A1827" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- clockwise orbit -->
                                <Ellipse Width="210" Height="210" StrokeThickness="3.5" StrokeDashArray="40 51.4"
                                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9FCAFF" Offset="0"/>
                                            <GradientStop Color="#1C6EB4" Offset="0.6"/>
                                            <GradientStop Color="#000061A5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="OrbitRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- counter-rotating precision ring -->
                                <Ellipse Width="198" Height="198" Stroke="#D2E4FF" StrokeThickness="1.5"
                                         StrokeDashArray="16.7 30 6.7 20" StrokeDashCap="Round" Opacity="0.6"
                                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="PrecisionRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- optical platen -->
                                <Grid Width="182" Height="182">
                                    <Grid.Clip>
                                        <EllipseGeometry Center="91,91" RadiusX="91" RadiusY="91"/>
                                    </Grid.Clip>
                                    <Ellipse Fill="#051422"/>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#401C6EB4" Offset="0"/>
                                                <GradientStop Color="#001C6EB4" Offset="0.85"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Rectangle Width="1" Fill="#339FCAFF" HorizontalAlignment="Center"/>
                                    <Rectangle Height="1" Fill="#339FCAFF" VerticalAlignment="Center"/>
                                    <Ellipse Margin="16" Stroke="#33D2E4FF" StrokeThickness="1" StrokeDashArray="3 3"/>

                                    <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="104"
                                               Foreground="#D2E4FF" Opacity="0.92"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- laser sweep -->
                                    <StackPanel VerticalAlignment="Top" IsHitTestVisible="False">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="SweepTranslate" Y="10"/>
                                        </StackPanel.RenderTransform>
                                        <Rectangle Height="28">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#009FCAFF" Offset="0"/>
                                                    <GradientStop Color="#669FCAFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle Height="2" Fill="White">
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="#9FCAFF" BlurRadius="14" ShadowDepth="0" Opacity="1"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Scanning" Foreground="#D2E4FF" FontSize="32" FontWeight="ExtraBold"/>
                            <StackPanel Orientation="Horizontal" Width="34" VerticalAlignment="Bottom" Margin="2,0,0,0">
                                <TextBlock x:Name="Dot1" Text="." Foreground="#9FCAFF" FontSize="32" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="Dot2" Text="." Foreground="#9FCAFF" FontSize="32" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="Dot3" Text="." Foreground="#9FCAFF" FontSize="32" FontWeight="ExtraBold"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Matching fingerprint, hold your finger still…" Foreground="#B8C7D9" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <Border Width="256" Height="6" CornerRadius="3" Background="#1AFFFFFF" ClipToBounds="True"
                                HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Border Width="90" Height="6" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#005592" Offset="0"/>
                                        <GradientStop Color="#D2E4FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProgressTranslate" X="-90"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <Border HorizontalAlignment="Center" Margin="0,16,0,0" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF"
                                BorderThickness="1" CornerRadius="999" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="#9FCAFF" VerticalAlignment="Center"/>
                                <TextBlock Text="Matching against this branch's enrolled fingerprints" Foreground="#99FFFFFF"
                                           FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SUCCESS / ALREADY RECORDED -->
                    <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MinWidth="720">
                        <Grid Width="290" Height="290" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse x:Name="SuccessGlow" Width="290" Height="290" IsHitTestVisible="False"/>
                            <Ellipse x:Name="SuccessDashRing" Width="250" Height="250" StrokeThickness="2"
                                     StrokeDashArray="3 3"/>
                            <Border x:Name="SuccessHalo" Width="208" Height="208" CornerRadius="104" Padding="8">
                                <Border x:Name="SuccessInner" CornerRadius="96">
                                    <TextBlock x:Name="SuccessIcon" Text="&#xE930;" FontFamily="{StaticResource IconFont}"
                                               FontSize="88" Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>

                        <Border x:Name="StatusPill" HorizontalAlignment="Center" CornerRadius="999" Padding="16,7"
                                BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusLabelText" Text="CLOCKED IN" FontSize="13" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="•" Foreground="#66FFFFFF" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusTimeText" Text="at 08:14 AM" Foreground="White" FontFamily="Consolas"
                                           FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="NameHeadlineText" Text="Welcome, Sarah Muteti" Foreground="White" FontSize="44"
                                   FontWeight="ExtraBold" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="900"/>
                        <TextBlock x:Name="DetailLineText" Text="Cashier • EMP-1001" Foreground="#C1C7D2" FontSize="15"
                                   FontWeight="Medium" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                        <Border HorizontalAlignment="Center" Margin="0,16,0,0" Background="#1AFFFFFF" BorderBrush="#26FFFFFF"
                                BorderThickness="1" CornerRadius="12" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LedgerIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="#B7F568" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LedgerText" Text="Attendance recorded • Have a productive shift!"
                                           Foreground="#E6FFFFFF" FontSize="13" FontWeight="Medium" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0.85">
                            <Border Width="256" Height="6" CornerRadius="3" Background="#26FFFFFF">
                                <Border Height="6" CornerRadius="3" Background="#7CB342" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ResetBarScale" ScaleX="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#C1C7D2" FontSize="10"
                                       FontFamily="Consolas">
                                <Run Text="Returning to the clock screen in "/><Run x:Name="SuccessCountdownRun" Text="5s" Foreground="White" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- NOT RECOGNIZED -->
                    <StackPanel x:Name="NotRecognizedPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MinWidth="720">
                        <Grid Width="300" Height="260" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Ellipse x:Name="AmberWave" Width="220" Height="220" Stroke="#66F5821F" StrokeThickness="2"
                                     RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="AmberWaveScale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Border Width="220" Height="220" CornerRadius="110" BorderBrush="#F5821F" BorderThickness="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1B2B3F" Offset="0"/>
                                        <GradientStop Color="#122234" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#F5821F" BlurRadius="40" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Grid>
                                    <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="90"
                                               Foreground="#F5821F" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,-14,0,0"/>
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                                            Background="#66000000" BorderBrush="#4DF5821F" BorderThickness="1"
                                            CornerRadius="999" Padding="12,3">
                                        <TextBlock Text="SCAN MISMATCH" Foreground="#F5821F" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="#0B192C" BorderThickness="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="128,20,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Color="#F5821F" Offset="0"/>
                                        <GradientStop Color="#FFAA47" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="!" Foreground="#0B192C" FontSize="22" FontWeight="ExtraBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Fingerprint not recognized" Foreground="White" FontSize="38" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Please place your finger firmly again, or see your branch manager for help."
                                   Foreground="#FED7AA" FontSize="16" FontWeight="Medium" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520" Margin="0,8,0,0"/>

                        <Border HorizontalAlignment="Center" MaxWidth="460" Margin="0,18,0,0" Background="#0DFFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#26F5821F" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="#F5821F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Margin="12,0,0,0" Foreground="#D9FFFFFF" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                                           VerticalAlignment="Center"
                                           Text="Tip: centre your fingertip on the glass and hold still for one full second without sliding."/>
                            </StackPanel>
                        </Border>

                        <Button Content="Try Again" Style="{StaticResource KioskAmberButton}" HorizontalAlignment="Center"
                                Margin="0,16,0,0" Click="TryAgainButton_Click"/>

                        <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="#66FFFFFF" FontSize="11">
                            <Run Text="Returning to the clock screen in "/><Run x:Name="NotRecCountdownRun" Text="8s" Foreground="#B3FFFFFF" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Viewbox>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#66081321">
                <Grid Margin="24,0">
                    <Button x:Name="ManagerLoginButton" Style="{StaticResource KioskGhostButton}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="ManagerLoginButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="#9FCAFF" VerticalAlignment="Center"/>
                            <TextBlock Text="Manager Login" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6690A8C4" FontSize="11"
                               Text="Firm, light pressure  •  Clean, dry finger"/>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1AFFFFFF"
                            CornerRadius="999" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FooterStatusDot" Width="8" Height="8" Fill="#F5821F" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FooterStatusText" Text="Connecting to reader…" Foreground="#CBD5E1"
                                       FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>