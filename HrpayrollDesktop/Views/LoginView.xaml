<UserControl x:Class="HrpayrollDesktop.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{StaticResource AppFont}"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="LoginCloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#8B95A5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Dimmed backdrop over the kiosk -->
    <Grid Background="#D9071526">
        <Viewbox StretchDirection="DownOnly" Stretch="Uniform" Margin="24">
            <Grid Width="960" Height="600">

                <Border CornerRadius="16" Background="White">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="12" Opacity="0.45"/>
                    </Border.Effect>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="480"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: brand panel -->
                    <Border Grid.Column="0" CornerRadius="16,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0F2A4A" Offset="0"/>
                                <GradientStop Color="#1B365D" Offset="0.5"/>
                                <GradientStop Color="#2563A8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <!-- Soft ambient orbs, kept fully inside the panel so nothing overflows the rounded corners -->
                            <Ellipse Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#552563A8" Offset="0"/>
                                        <GradientStop Color="#002563A8" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#337CB342" Offset="0"/>
                                        <GradientStop Color="#007CB342" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Grid Margin="44">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="48" Height="48" Background="#1AFFFFFF" CornerRadius="10"
                                            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6">
                                        <Image Source="/Assets/dhwarsh-logo.png" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DHWARSH HR" Foreground="White" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="Branch Operations Hub" Foreground="#B9D3F0" FontSize="11" FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="400" HorizontalAlignment="Left">
                                    <TextBlock Text="Your whole workforce," Foreground="White" FontSize="34" FontWeight="Bold"
                                               TextWrapping="Wrap" LineHeight="40"/>
                                    <TextBlock Text="one clear view." FontSize="34" FontWeight="Bold" LineHeight="40" Margin="0,0,0,16">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#BFE3FF" Offset="0"/>
                                                <GradientStop Color="#DDF4E8" Offset="0.55"/>
                                                <GradientStop Color="#7CD9A5" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="Integrated Kenya payroll &amp; biometric attendance management for high-volume branch terminals."
                                               Foreground="#C6DCF5" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>

                                <Border Grid.Row="2" HorizontalAlignment="Left" Background="#4D000000" BorderBrush="#26FFFFFF"
                                        BorderThickness="1" CornerRadius="999" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TerminalPillText" Text="Attendance terminal" Foreground="#D6E4F5" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT: sign-in form -->
                    <Border Grid.Column="1" CornerRadius="0,16,16,0" Background="White">
                        <Grid>
                            <Button Style="{StaticResource LoginCloseButtonStyle}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,14,14,0" Width="34" Height="34"
                                    ToolTip="Back to clock-in screen" Click="BackButton_Click">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                            </Button>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                                <Image Source="/Assets/dhwarsh-logo.png" Height="84" Margin="0,0,0,20" Stretch="Uniform"/>

                                <TextBlock Text="Manager sign-in" Foreground="{StaticResource HeadingBrush}" FontSize="24"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Enter your branch manager credentials to open the console."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,24"/>

                                <TextBlock Text="MANAGER USERNAME OR WORK ID" Style="{StaticResource LabelStyle}"/>
                                <Grid Margin="0,0,0,14">
                                    <TextBox x:Name="UsernameBox" Padding="36,9,12,9" KeyDown="Field_KeyDown"/>
                                    <TextBlock Text="&#xE779;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>

                                <TextBlock Text="PASSWORD" Style="{StaticResource LabelStyle}"/>
                                <Grid Margin="0,0,0,8">
                                    <PasswordBox x:Name="PasswordBox" Padding="36,9,12,9" KeyDown="Field_KeyDown"/>
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>

                                <TextBlock x:Name="LoadingText" Text="Signing in..." Foreground="{StaticResource BlueBrush}"
                                           FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>

                                <Button x:Name="LoginButton" Click="LoginButton_Click" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sign In to Console" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BackButton_Click">
                                    <TextBlock Text="Back to clock-in screen" FontSize="12" FontWeight="SemiBold"/>
                                </Button>

                                <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                           Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>